# ============================================================
#  XATIRCHI BANDLIK PLATFORMASI - Muhit o'zgaruvchilari
#  Bu faylni ".env" nomi bilan nusxalang:  cp .env.example .env
# ============================================================

# --- Ma'lumotlar bazasi (PostgreSQL / Supabase) ---
# Supabase: Project Settings -> Database -> Connection string -> URI
# Pgbouncer (pooler, 6543-port) — ilova ishlashi uchun:
DATABASE_URL="postgresql://postgres.xxxxxxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# To'g'ridan-to'g'ri ulanish (5432-port) — migratsiya va seed uchun:
DIRECT_URL="postgresql://postgres.xxxxxxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Sessiya imzo kaliti ---
#
#  !!! DIQQAT !!!
#  Kamida 32 ta belgi. Yaratish:  openssl rand -base64 32
#  Almashtirilmasa, tizim production rejimida ishga tushmaydi.
#
SESSION_SECRET="ALMASHTIRING-openssl-rand-base64-32-natijasi"

# --- Birinchi administrator ---
#
#  Faqat `npm run db:seed` bir marta ishlaganda yaratiladi.
#  Birinchi kirishdan keyin parolni ALBATTA almashtiring.
#  Kamida 12 ta belgi. Yaratish:  openssl rand -base64 24
#
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ALMASHTIRING-kuchli-parol"
ADMIN_FISH="Tizim administratori"

# --- Ilova manzili ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Sun'iy intellekt xulosasi (IXTIYORIY) ---
#
#  Bo'sh qoldirilsa, tizim TO'LIQ ISHLAYDI: xulosa va tavsiyalar
#  belgilangan chegaralar bo'yicha hisoblanadi.
#
#  BITTASINI qo'ying:
#
#  1) Groq - bepul darajasi bor, tez
#     Kalit: https://console.groq.com/keys   ("gsk_..." bilan boshlanadi)
# GROQ_API_KEY="gsk_..."
#
#  2) OpenAI - PULLIK (bepul darajasi yo'q)
#     Kalit: https://platform.openai.com/api-keys   ("sk-..." bilan boshlanadi)
# OPENAI_API_KEY="sk-..."
#
#  3) Google Gemini - bepul darajasi bor
#     Kalit: https://aistudio.google.com/apikey   ("AIza..." bilan boshlanadi)
# GEMINI_API_KEY="AIza..."
#
#  4) Anthropic Claude - pullik
#     Kalit: https://console.anthropic.com   ("sk-ant-..." bilan boshlanadi)
# ANTHROPIC_API_KEY="sk-ant-..."
#
#  Bir nechtasi qo'yilsa tartib: Groq -> OpenAI -> Gemini -> Anthropic.
#  Aniq tanlash uchun:
# AI_PROVAYDER="groq"     # yoki "openai" / "gemini" / "anthropic"
#
#  Model nomi vaqt o'tishi bilan o'zgaradi. Kodga tegmasdan
#  almashtirish uchun (odatiy qiymatlar qavsda):
# GROQ_MODEL="openai/gpt-oss-120b"
# OPENAI_MODEL="gpt-4o-mini"
# GEMINI_MODEL="gemini-2.5-flash"
# ANTHROPIC_MODEL="claude-sonnet-5"
#
#  ── HUDHUD (ovozli AI agent: hokim, bandlik, administrator) ──
#
#  Agent asbob chaqirishi (function calling) kerak, shuning uchun u FAQAT
#  OpenAI yoki Groq bilan ishlaydi (Gemini va Anthropic bu yerda ishlatilmaydi).
#  Kalit yuqoridagi OPENAI_API_KEY (yoki GROQ_API_KEY). Kalit yo'q bo'lsa agent
#  "oddiy rejim"da qoladi: sahifani ovozli buyruq bilan ochadi va tuman holatini
#  aytadi, lekin erkin savollarga javob bermaydi.
# AGENT_PROVAYDER="openai"          # yoki "groq"; yozilmasa: OpenAI kaliti bor bo'lsa OpenAI
# AGENT_MODEL="gpt-4.1-mini"        # AGENT_MODEL → OPENAI_MODEL/GROQ_MODEL → odatiy suhbat modeli
#                                   # Batafsil suhbat uchun, hisobingizda ochiq bo'lsa, gpt-4.1 tanlash mumkin
# AGENT_JAVOB_TOKEN="2000"         # 256–4096; kirillcha batafsil izoh ham sig'ishi uchun
# AGENT_KUNLIK_LIMIT="120"          # bir xodimga kuniga nechta AI xabari (odatiy: hokim/admin 120, rahbar 80, mutaxassis 40)
# AGENT_OYLIK_LIMIT="4000"          # butun tuman bo'yicha oyiga (byudjet to'sig'i)
# AGENT_OVOZ_LIMIT="900"            # bir xodimga kuniga server tomonda matnga aylantiriladigan ovoz (soniya)
# AGENT_STT_MODEL="whisper-1"       # ovozni matnga aylantirish modeli (Groq uchun: whisper-large-v3-turbo)
# AGENT_TTS="1"                    # Server ovozli javobi; "0" — o'chirish
# AGENT_TTS_PROVIDER="elevenlabs"  # yoki "openai"; ElevenLabs kaliti bor bo'lsa avtomatik ElevenLabs
# ELEVENLABS_API_KEY=""            # Faqat serverda/Vercel'da; NEXT_PUBLIC_ ishlatmang
# ELEVENLABS_VOICE_ID=""           # ElevenLabs -> Voices -> tanlangan ovozning Voice ID si
# ELEVENLABS_MODEL_ID="eleven_v3"  # API katalogida o'zbek tili borligi tekshiriladi; o'zbekchasiz model rad etiladi
# AGENT_TTS_MODEL="gpt-4o-mini-tts" # o'zbekcha talaffuz ko'rsatmasi bilan; model topilmasa tts-1 zaxirasi
# AGENT_TTS_VOICE="cedar"            # ovoz: marin, cedar, onyx, alloy, echo, fable, nova, shimmer, coral, sage, ash
# AGENT_REALTIME="1"                # Jonli suhbat (WebRTC). AGENT_TTS=1 bo'lsa ham ochiq; "0" — alohida o'chirish
# AGENT_REALTIME_MODEL="gpt-realtime" # Matnga o'tkazib qayta o'qish o'rniga to'g'ridan-to'g'ri audio suhbat
# AGENT_REALTIME_VOICE="cedar"       # Native OpenAI ovozi; ElevenLabs tanlansa shu ovoz ishlatilmaydi
# AGENT_REALTIME_DAILY_LIMIT="6"     # Bir xodim uchun 24 soatda jonli ulanishlar (1–24)
#
#  ── Jonli suhbat: Gemini Live (tushunish) + ElevenLabs (ovoz) ──  hujjatlar/GEMINI-JONLI.md
#  GEMINI_API_KEY va ElevenLabs (yuqorida) to'liq bo'lsa jonli suhbat OpenAI o'rniga Gemini bilan ishlaydi.
#  ZAXIRA: Gemini yoki ElevenLabs ishlamasa avtomatik OpenAI (OPENAI_API_KEY + AGENT_TTS=1 kifoya): eshitadi,
#  javob beradi va o'z ovozi bilan gapiradi; ular ishlasa Gemini + ElevenLabs ishlayveradi.
# GEMINI_API_KEY=""                   # Faqat serverda/Vercel'da; NEXT_PUBLIC_ ishlatmang. Brauzerga yakka foydalanishli token beriladi
# GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"  # Google "preview" modellarni almashtirib turadi: noto'g'ri bo'lsa "Уланишни текшириш" ko'rsatadi
# GEMINI_LIVE_CHIQISH="matn"          # "matn" (tavsiya) yoki "transkript" (model faqat ovozli bo'lsa: ovozi tashlanadi, matni olinadi)
# GEMINI_API_SURUM="v1alpha"          # efemer token hozir v1alpha'da; "v1beta" ham tanlanadi
# AGENT_JONLI_PROVAYDER="openai"      # yozilsa Gemini o'chadi va OpenAI Realtime qaytadi
#
#  Kalitni qo'ygach TEKSHIRING - ikki yo'l bor:
#    · saytda:  Boshqaruv -> "Sun'iy intellekt ulanishi" -> Tekshirish
#    · terminalda:  npm run ai-tekshir
#  Ilova kalit noto'g'ri bo'lsa ham ishlayveradi, shuning uchun
#  bu tekshiruvsiz xatoni sezmaysiz.
#
#  AI ga FAQAT jamlangan sonlar va katalog qiymatlari yuboriladi.
#  F.I.Sh., manzil, telefon va xodim yozgan erkin matn
#  YUBORILMAYDI - tafsiloti: src/lib/xonadon-xulosa.ts

# ============================================================
#  To'ldirgandan keyin:
#    npm run db:deploy   — jadvallar va Supabase himoyasi
#    npm run db:seed     — 70 MFY, raislar, administrator
#    npm run tekshir     — hammasi joyidami?
# ============================================================

# ─────────────────────────────────────────────────────────────
#  TELEGRAM XABARNOMASI
# ─────────────────────────────────────────────────────────────
#
# Bularsiz ham tizim TO'LIQ ishlaydi: xabarlar navbatga
# to'planaveradi va administrator panelida "navbatda N ta"
# deb ko'rinadi. Token qo'yilgach, ular yuboriladi.
#
# 1. Telegram'da @BotFather ga yozing, /newbot buyrug'i bilan
#    bot yarating. U bergan tokenni shu yerga qo'ying.
TELEGRAM_BOT_TOKEN=
#
# 2. Bot foydalanuvchi nomi (@ belgisisiz). Xodimga "Botni
#    ochish" tugmasi shundan yasaladi.
TELEGRAM_BOT_NOMI=
#
# 3. Webhook sir so'zi - o'zingiz o'ylab toping, uzun bo'lsin.
#    Webhook manzili OCHIQ: autentifikatsiya yo'q, chunki
#    Telegram serverida bizning cookie yo'q. Sir so'zsiz har
#    kim soxta so'rov yuborib, o'z chat ID sini boshqa
#    xodimning hisobiga bog'lab olishi mumkin.
TELEGRAM_WEBHOOK_SIRI=
#
# 4. Webhook'ni ro'yxatdan o'tkazish (bir marta):
#    curl -F "url=https://SIZNING-DOMEN/api/telegram/webhook" \
#         -F "secret_token=YUQORIDAGI_SIR" \
#         https://api.telegram.org/botTOKEN/setWebhook
#
# 5. Navbatni jo'natish uchun Vercel Cron siri
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
#  IDROK — YASHIRIN STATISTIKA API (IXTIYORIY)
# ─────────────────────────────────────────────────────────────
#
# Hokimiyatning AI yordamchisi IDROK `GET /api/idrok/stats` dan
# jamlangan raqamlarni o'qiydi va `X-IDROK-Key` sarlavhasida shu
# kalitni yuboradi. Bo'sh qoldirilsa yo'l O'CHIQ (404 qaytaradi).
#
# Uzun tasodifiy qiymat:  openssl rand -base64 32
# Xuddi shu qiymat IDROK tomonida ham yoziladi. Haqiqiy kalitni
# bu faylga EMAS, faqat `.env` va Vercel sozlamasiga qo'ying.
IDROK_API_KEY=
