// ============================================================
//  XATIRCHI TUMANI - BANDLIK PLATFORMASI
//  Ma'lumotlar bazasi: PostgreSQL (Supabase bilan mos)
//
//  Uchta asosiy obyekt bir-biriga zanjir bo'lib ulanadi:
//
//    MAHALLA ──▶ XONADON ──▶ ISHSIZ FUQARO ──▶ CHORA-TADBIR
//    (baza)      (xatlov)     (shaxsiy anketa)   (topshiriq)
//
//  MAHALLA baza raqamlarini saqlaydi (svod jadvalidan) - ular
//  qamrov foizining maxraji. XONADON ishsizlarni TOPADI, ISHSIZ
//  FUQARO ular bilan ISHLAYDI, CHORA-TADBIR esa kim nima qilishi
//  kerakligini va muddatini yozib qo'yadi.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
//  ROLLAR VA FOYDALANUVCHILAR
// ─────────────────────────────────────────────────────────────

enum Rol {
  /// Mahalla yettiligi a'zosi - xonadonlarni xatlovdan o'tkazadi.
  /// FAQAT o'z mahallasini ko'radi.
  YETTILIK

  /// Bandlikka ko'maklashish markazi xodimi - ishsizlar bilan
  /// suhbat o'tkazadi, taklif beradi, joylashtiradi. Butun tumanni ko'radi.
  BANDLIK

  /// Bandlik markazi rahbari - operatsion panel va tayinlash huquqi
  BANDLIK_RAHBAR

  /// Tuman hokimi va o'rinbosarlari - faqat tahlil paneli, o'zgartirmaydi
  HOKIM

  /// Tizim administratori - foydalanuvchi yaratadi, kataloglarni boshqaradi
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  /// Kirish uchun login - lotin harflar va raqamlar
  username     String  @unique
  /// scrypt hash: "salt:hash" ko'rinishida
  passwordHash String
  fullName     String
  /// Lavozimi - anketadagi imzo qatorida chiqadi
  position     String?
  phone        String?
  rol          Rol

  /// YETTILIK roli uchun MAJBURIY - xodim faqat shu mahallani ko'radi.
  /// Boshqa rollar uchun bo'sh (ular butun tumanni ko'radi).
  mahallaId String?
  mahalla   Mahalla? @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  /// Faol emas qilingan xodim tizimga kira olmaydi, lekin uning
  /// yozuvlari saqlanib qoladi (o'chirish tarixni buzardi).
  faol Boolean @default(true)

  /// Administrator tayinlagan oxirgi parol - SHIFRLANGAN holda.
  ///
  /// Bazani ochgan odam faqat tushunarsiz belgilar ko'radi;
  /// ochish uchun ilovaning `SESSION_SECRET` i ham kerak.
  ///
  /// Kirish paroli bundan MUSTAQIL: u scrypt bilan xeshlangan va
  /// hech qachon orqaga o'qilmaydi. Bu maydon faqat "qanday parol
  /// berganimni ko'ray" degan ehtiyoj uchun.
  berilganParol String?

  /// Parol oxirgi marta qachon tayinlangani
  parolBerilganVaqt DateTime?

  /// Parolni birinchi kirishda almashtirish talab qilinadimi.
  ///
  /// Ikkinchi vazifasi ham bor: `berilganParol` hali amaldami
  /// yoki yo'qmi - shuni bildiradi. `true` bo'lsa xodim hali
  /// o'zgartirmagan, ya'ni saqlangan parol to'g'ri. `false`
  /// bo'lsa xodim o'z parolini qo'ygan va saqlangani ESKIRGAN.
  parolAlmashtirilsin Boolean @default(true)

  /// SESSIYA AVLODI.
  ///
  /// ── Nega kerak ──
  ///
  /// Sessiya cookie'si imzolangan payload — serverda uning
  /// nusxasi yo'q. Ya'ni uni BEKOR QILIB bo'lmaydi: parol
  /// o'zgarsa ham, eski cookie 12 soat ishlayveradi.
  ///
  /// Amalda bu shuni bildiradi: xodimning paroli o'g'irlangani
  /// bilinib, parol almashtirilsa ham, o'g'ri hali ham ichkarida.
  ///
  /// Bu raqam cookie ichiga yoziladi va har so'rovda
  /// solishtiriladi. Parol almashganda bittaga oshadi —
  /// eski cookie'lar o'sha zahoti yaroqsiz bo'ladi.
  sessiyaVersiyasi Int @default(1)

  // ── TELEGRAM ──

  /// Telegram chat ID - xabar aynan shu raqamga yuboriladi.
  ///
  /// Xodim o'zi bog'laydi: ilovadan bir martalik kod oladi va
  /// uni botga yuboradi. Administrator qo'lda kirita olmaydi -
  /// noto'g'ri raqam kiritilsa, xabar BEGONA odamga ketardi.
  telegramChatId String? @unique

  /// Qachon bog'langani - xodim "bog'langanmi?" degan savolga
  /// javob ko'rishi uchun
  telegramSana DateTime?

  /// Bog'lash uchun bir martalik kod. Ishlatilgach tozalanadi.
  telegramKodi String? @unique

  /// Kod qachon berilgani - eskirgan kod qabul qilinmaydi
  telegramKodiVaqti DateTime?

  oxirgiKirish DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  xatlovlar          Household[]
  suhbatlar          UnemployedPerson[]
  topshiriqlar       ActionPlan[]
  auditYozuvlar      AuditLog[]
  itVaucherlar       ItVaucher[]
  xabarlar           Xabarnoma[]
  joylashuvXabarlari JoylashuvXabari[]  @relation("JoylashuvXabarchi")
  joylashuvHalQilgan JoylashuvXabari[]  @relation("JoylashuvHalQilgan")

  /// Botdagi tugallanmagan suhbat
  botSuhbati               BotSuhbati?
  /// Kiritgan va tekshirgan joylashuv dalillari
  kiritganDalillar         JoylashuvDalili[] @relation("DalilKiritgan")
  tasdiqlaganDalillar      JoylashuvDalili[] @relation("DalilTasdiqlagan")
  halQilganIshBeruvchilar  IshBeruvchi[]     @relation("IshBeruvchiHalQilgan")
  /// Модерациядан ўтказган эълонлар
  moderatsiyaQilganElonlar Vacancy[]         @relation("ElonModeratsiyasi")
  /// Киритган ишга жойлашиш воқеалари
  kiritganJoylashishlar    IshgaJoylashish[] @relation("JoylashishKiritgan")

  /// Oilaviy rejalar: yaratgan, mas'ul va aloqa yozgan xodim
  yaratganRejalar     OilaRejasi[]        @relation("RejaYaratgan")
  masulRejalar        OilaRejasi[]        @relation("RejaMasul")
  aloqaQaydlari       OilaAloqasi[]       @relation("AloqaQaydEtgan")
  /// Mas'ul xodim sifatida biriktirilgan chora-tadbirlar
  masulChoralar       ActionPlan[]        @relation("ChoraMasulXodim")
  /// Kiritgan kuzatuv tekshiruvlari
  kuzatuvlar          KuzatuvTekshiruvi[]
  /// Yo'llagan nomzodlar
  yaratganYollanmalar NomzodYollanmasi[]  @relation("YollanmaYaratgan")

  @@index([rol, faol])
  @@index([mahallaId])
}

// ─────────────────────────────────────────────────────────────
//  MAHALLA - KATALOG VA BAZA STATISTIKASI
// ─────────────────────────────────────────────────────────────

/// 70 ta MFY. Raqamlar 31.08.2026 svod jadvalidan olinadi va
/// qamrov foizini hisoblashda MAXRAJ bo'lib xizmat qiladi.
model Mahalla {
  id         String @id @default(cuid())
  tartib     Int    @unique
  nomi       String @unique
  nomiKirill String

  /// Mahallada xatlov uchun MAS'UL shaxs - hokim yordamchisi.
  ///
  /// Ilgari bu maydonlar MFY RAISINI saqlardi va nomi ham shunday
  /// edi (`raisFish`). Amalda esa xatlovni rais emas, hokim
  /// yordamchisi kiritadi: rais saylanadigan jamoat vakili, hokim
  /// yordamchisi esa shu ish uchun tayinlangan mansabdor.
  ///
  /// Nomi ataylab o'zgartirildi: "rais" deb qolsa, keyin kod
  /// o'qigan odam bu maydonda MFY raisi turgan deb o'ylardi va
  /// uning telefoniga qo'ng'iroq qilardi.
  /// Lavozim BO'SH bo'lishi mumkin (rasmiy ro'yxatda "Вакант"),
  /// shuning uchun null qabul qiladi. Bo'sh qiymatni "—" yoki
  /// bo'sh satr bilan to'ldirish mumkin edi, lekin unda "hali
  /// tayinlanmagan" va "kiritilmagan" holatlari qo'shilib ketardi.
  masulFish     String?
  masulTelefon  String?
  /// 'Ҳоким ёрдамчиси' - lavozim nomi o'zgarishi mumkin, shuning
  /// uchun qat'iy emas, matn sifatida saqlanadi
  masulLavozimi String

  aholi   Int
  xonadon Int
  oila    Int

  kambagalYanvar         Int
  kambagalJami           Int
  davlatTaminotida       Int
  kambagalOilalar        Int
  kambagallikChegarasida Int

  mehnatgaLayoqatli Int
  band              Int
  /// Ro'yxatdagi ishsizlar soni - qamrov foizining maxraji
  ishsiz            Int

  ayollarDaftari       Int
  ijtimoiyReestr       Int
  migratsiyadanQaytgan Int
  oliyBitiruvchi       Int
  ortaMaxsusBitiruvchi Int
  maktabBitiruvchi     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  xodimlar       User[]
  xonadonlar     Household[]
  ishsizlar      UnemployedPerson[]
  ishOrinlar     Vacancy[]
  itVaucherlar   ItVaucher[]
  kesmalar       HouseholdKesma[]
  ishBeruvchilar IshBeruvchi[]

  @@index([nomi])
}

// ─────────────────────────────────────────────────────────────
//  XONADON XATLOVI - 11 BO'LIM
// ─────────────────────────────────────────────────────────────

enum XatlovHolati {
  /// Qoralama - xodim to'ldirishni boshlagan, lekin tugatmagan.
  /// Telefon o'chsa yoki xonadon egasi band bo'lsa, keyin davom etadi.
  QORALAMA
  /// Yuborilgan - to'liq to'ldirilgan va tekshiruvdan o'tgan
  YUBORILGAN
  /// Tasdiqlangan - bandlik markazi ko'rib chiqqan
  TASDIQLANGAN
}

model Household {
  id     String       @id @default(cuid())
  holati XatlovHolati @default(QORALAMA)

  viloyat   String  @default("Navoiy")
  tuman     String  @default("Xatirchi")
  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  /// Xonadon manzili - takror xatlovni aniqlashda ishlatiladi
  manzil String

  // ── Oila boshlig'i ──
  oilaBoshligi             String
  /// Oila boshlig'i jinsi. Nafaqa yoshi ayol va erkak uchun
  /// har xil (55/60), shuning uchun yosh tekshiruvi busiz
  /// ishlamaydi.
  oilaBoshligiJinsi        String?
  /// Oila boshlig'ining tug'ilgan SANASI.
  ///
  /// Ilgari faqat `tugilganYili` (yil) so'ralardi, ishsiz fuqaroda
  /// esa to'liq sana - bir tushuncha ikki shaklda edi. Xodim oila
  /// boshlig'ini ishsizlar ro'yxatiga ham qo'shganda sanani
  /// qaytadan terishi kerak bo'lardi.
  ///
  /// `tugilganYili` TUSHIRILMADI: ishlab turgan bazadagi
  /// yozuvlarda faqat yil bor va uni yo'qotish ma'lumot yo'qotish
  /// bo'lardi. Yangi anketalarda ikkisi ham to'ldiriladi (yil
  /// sanadan olinadi), eskilarida esa yil o'z holida qoladi.
  oilaBoshligiTugilganSana DateTime?
  tugilganYili             Int?
  telefon                  String?

  jamiAzo     Int
  bolalarSoni Int @default(0)

  /// Bolalarning yosh guruhlari.
  ///
  /// «12 ta bola» degan raqamdan chora chiqmaydi: 0-3 yosh bola
  /// onasini uyda ushlab turadi, 3-17 yosh bog'cha va maktab
  /// masalasi, 18 dan katta farzand esa aslida ISHSIZ FUQARO va
  /// bandlik markazining ishi. Uchtasiga uch xil chora kerak.
  bolalar0_3Yosh   Int @default(0)
  bolalar3_17Yosh  Int @default(0)
  bolalar18Yoshdan Int @default(0)

  // ── I. MEHNAT VA BANDLIK ──
  mehnatgaLayoqatli       Int  @default(0)
  /// Mehnatga layoqatsizlar - ish yoshida, lekin ishlay olmaydi.
  ///
  /// Nega alohida ustun kerak bo'ldi: dalada shunday xonadon
  /// chiqdi - ilgari nogironligi bor edi, hozir rasman yo'q,
  /// lekin o'zini mehnatga layoqatsiz deb hisoblaydi va
  /// ishlamaydi. Xodim uni `mehnatgaLayoqatli` dan chiqarib
  /// tashladi va `ishsizlarSoni` ga qo'shdi - anketa esa
  /// "ishlaydigan + ishsiz, mehnatga layoqatlilardan ko'p" deb
  /// rad etdi. Odam bor, lekin uni yozadigan katak yo'q edi.
  ///
  /// Bu son `ishlaydiganlar + ishsizlarSoni <= mehnatgaLayoqatli`
  /// qoidasiga KIRMAYDI: layoqatsiz odam ishsiz emas, chunki u
  /// ish qidirmaydi. Bandlik markazi unga ish taklif qilmaydi -
  /// unga ijtimoiy yordam kerak.
  mehnatgaLayoqatsiz      Int  @default(0)
  ishlaydiganlar          Int  @default(0)
  /// Davlat korxonalarida band
  davlatKorxonada         Int  @default(0)
  /// Xo'jalik yurituvchi subyektlarda band
  xususiySektorda         Int  @default(0)
  ishsizlarSoni           Int  @default(0)
  /// 3 yoshgacha bola tarbiyasidagi, bog'cha bo'lsa ishlashga tayyor ayollar
  bogchaKutayotganAyollar Int  @default(0)
  /// Qancha vaqtdan buyon ishsiz (oyda) - eng uzun muddat
  ishsizlikMuddatiOy      Int?

  ishTuriIstagi      String?
  kasbHunarIstagi    Boolean  @default(false)
  kasbHunarYonalishi String[]
  bandlikTakliflari  String?

  // ── II. TADBIRKORLIK VA KREDIT-SUBSIDIYA ──
  tadbirkorlikIstagi    Boolean  @default(false)
  tadbirkorlikSohasi    String[]
  moliyaEhtiyoji        Boolean  @default(false)
  moliyaTuri            String[]
  /// So'mda. Byudjet rejasiga to'g'ridan-to'g'ri kiradigan raqam.
  talabQilinganMablag   BigInt?
  mablagYonalishi       String[]
  /// «Бошқа» танланганда — қайси йўналиш экани
  mablagYonalishiBoshqa String?

  // ── II-B. CHET ELDA MEHNAT MIGRATSIYASI ──
  //
  // Xatirchi tumani uchun bu ALOHIDA bo'lim bo'lishi shart:
  // ko'p oilaning asosiy daromadi chet eldagi a'zosidan keladi
  // va bu raqamsiz oila ahvolini to'g'ri baholab bo'lmaydi.
  // "Daromadi yo'q" deb belgilangan oila aslida oyiga bir necha
  // million so'm olayotgan bo'lishi mumkin.

  /// Oilada chet elda ishlayotgan a'zo bormi
  chetElMehnati      Boolean  @default(false)
  /// Nechta a'zo chet elda ishlaydi
  chetElIshchilar    Int      @default(0)
  /// Qaysi davlat(lar)da - katalogdan
  chetElDavlatlari   String[]
  /// Katalogda "Boshqa" tanlansa - davlat nomi qo'lda
  chetElBoshqaDavlat String?
  /// Oyiga oilaga yuboriladigan pul (so'mda).
  ///
  /// Aynan YUBORILADIGAN summa so'raladi, chet eldagi maosh
  /// emas: oila byudjetiga kirib keladigan pul shu.
  chetElOylikPul     BigInt?

  /// Пул қайси валютада айтилган: UZS | USD | EUR.
  ///
  /// Оила қайси пулда олса шунда айтади: Россиядан рубль,
  /// Кореядан доллар. Илгари ҳаммаси «сўм» деб ёзиларди ва
  /// ҳисоботда 500 (доллар) билан 5 000 000 (сўм) бир устунга
  /// қўшилиб кетарди.
  chetElValyuta String?

  /// Ҳисобот учун СЎМГА келтирилган қиймат.
  ///
  /// Сақлаш пайтида ҳисобланади ва ўшанда қотиб қолади: акс
  /// ҳолда курс ўзгарган куни ўтган ойги ҳужжатдаги рақам ҳам
  /// ўзгариб кетарди ва иккита ҳужжат бир-бирига тўғри
  /// келмасди.
  chetElOylikPulSom BigInt?

  /// Қайси шаҳарларда — «давлат|шаҳар» кўринишида
  chetElShaharlari   String[]
  /// «Бошқа давлат» танланганда — шаҳар номи
  chetElBoshqaShahar String?

  // ── III. DAROMAD ──
  oylikDaromad         BigInt?
  daromadManbalari     String[]
  daromadImkoniyati    String?
  kambagallikSabablari String[]

  // ── IV. BOLALAR TA'LIMI ──
  maktabgachaYoshdagi        Int      @default(0)
  maktabgachaQamrovda        Int      @default(0)
  maktabgachaQamrovsizSababi String?
  maktabYoshdagi             Int      @default(0)
  maktabQamrovda             Int      @default(0)
  bolalarQiziqishlari        String[]
  togarakQamrovi             Int      @default(0)
  togarakSababi              String?

  // ── V. SOG'LIQ ──
  uzoqDavolanish       Boolean @default(false)
  uzoqDavolanishIzoh   String?
  doriEhtiyoji         String?
  tibbiyXizmatEhtiyoji String?
  oxirgiTibbiyKorik    String?

  // ── VI. UY-JOY VA KOMMUNAL ──
  uyHolati        String?
  ichimlikSuvi    String?
  sugorishSuvi    Boolean @default(false)
  elektr          Boolean @default(true)
  gaz             Boolean @default(false)
  /// 'Табиий газ' yoki 'Пропан (баллон)'. Farqi muhim: markazlashgan
  /// quvur bor joyda muammo boshqa, balon bilan yashaydigan oilada
  /// boshqa - chora-tadbir ham har xil bo'ladi.
  gazTuri         String?
  kanalizatsiya   Boolean @default(false)
  sanitariya      String?
  boshqaMuammolar String?

  // ── VII. IJTIMOIY HIMOYA ──
  nogironlikBor     Boolean @default(false)
  nogironlikIzoh    String?
  /// Nogironligi bor shaxslar: har biri uchun F.I.Sh. va oiladagi
  /// o'rni. JSON massiv sifatida saqlanadi - alohida jadval
  /// yaratish bu hajm uchun ortiqcha, lekin matn maydonida
  /// saqlash ham noto'g'ri: keyin ularni sanab bo'lmaydi.
  nogironShaxslar   Json?
  yolgizKeksa       Boolean @default(false)
  parvarishgaMuhtoj Boolean @default(false)
  parvarishIzoh     String?
  /// Parvarishga muhtoj shaxslar - nogironlik bilan bir xil shakl
  parvarishShaxslar Json?

  /// Ёлғиз яшовчи кексалар — ким экани.
  ///
  /// Ногиронлик ва парвариш каби: «ҳа, бор» деган белгидан
  /// «Инсон» маркази ҳеч кимни топа олмайди. Исм ва оиладаги
  /// ўрни ёзилса, рўйхат тўғридан-тўғри ишга киради.
  yolgizKeksaShaxslar Json?
  boshqaMuhtojlar     String?

  // ── VIII. HUJJATLASHTIRISH ──
  hujjatlarToliq  Boolean @default(true)
  hujjatIzoh      String?
  xizmatTosiqlari String?

  // ── IX. TOMORQA, YER, CHORVA, HUNARMANDCHILIK ──
  tomorqaBor     Boolean @default(false)
  /// ESKI MAYDON - endi to'ldirilmaydi, `ekinMaydoni` ishlatiladi.
  /// Tushirilmadi: ishlab turgan bazada migratsiya talab qiladi va
  /// eski xatlovlardagi qiymat yo'qolardi.
  tomorqaMaydoni Float?
  /// EKIN ekiladigan maydon.
  ///
  /// Ilgari "tomorqa maydoni" so'ralardi, lekin tomorqaning ustida
  /// uy ham turadi - o'sha yerdan foydalanib bo'lmaydi. Rejalashtirish
  /// uchun ekin ekish mumkin bo'lgan qism kerak.
  ekinMaydoni    Float?

  /// Томорқадан ҚАНЧАЛИК фойдаланилаётгани: 'Alo', 'Yaxshi',
  /// 'Qoniqarli', 'Yomon'.
  ///
  /// ── Нега майдон сони етмайди ──
  ///
  /// «10 сотих ер бор» деган рақамдан ҳеч нарса чиқмайди: ўша
  /// 10 сотих экилган ҳам, ташлаб қўйилган ҳам бўлиши мумкин.
  /// Икковига мутлақо БОШҚА чора керак — биринчисига уруғлик ва
  /// сув, иккинчисига эса аввало сабабини аниқлаш.
  ///
  /// ── Нега кейинги хатлов учун муҳим ──
  ///
  /// Бу баҳо хонадон тарихида сақланади. Кейинги йил ўша
  /// хонадонга борилганда «ўтган сафар ёмон эди, ҳозир
  /// қониқарли» деб КЎРСАТИШ мумкин бўлади. Яъни бу — берилган
  /// ёрдам натижа бердими деган саволнинг ўлчови.
  tomorqaFoydalanish String?

  /// Томорқадан ТАШҚАРИ, фойдаланувдаги ер бормиз.
  ///
  /// Оилада кўпинча томорқадан бошқа ер ҳам бўлади: қариндошдан
  /// қолган, маҳалладан ажратилган, вақтинча берилган. У
  /// ижарага олинган ер эмас (у алоҳида сўралади) ва томорқа
  /// ҳам эмас — лекин режалаштиришда ҳисобга олиниши керак,
  /// чунки унда ҳам экин экса бўлади.
  qoshimchaYerBor     Boolean @default(false)
  qoshimchaYerMaydoni Float?

  /// Chorvachilik alohida savol bo'ldi: ilgari erkin matn edi va
  /// "bor", "yo'q", "2 ta sigir" kabi turli javoblar tushardi -
  /// ularni sanab bo'lmasdi.
  chorvaBor     Boolean  @default(false)
  /// 'Йирик шохли', 'Майда шохли', 'Парранда' - bir nechtasi
  chorvaTurlari String[]

  /// Чорва БОШ сони — тур бўйича.
  ///
  /// «Чорваси бор» деган белгидан режа чиқмайди: 2 та товуқ ҳам,
  /// 40 та қорамол ҳам бир хил кўринади. Субсидия ва ем-хашак
  /// ёрдами эса айнан бош сонига қараб берилади.
  yirikShoxliSoni Int?
  maydaShoxliSoni Int?
  parrandaSoni    Int?
  chorvachilik    String?

  hunarmandBor     Boolean  @default(false)
  /// Tayyor variantlar ro'yxatidan tanlanadi
  hunarTurlari     String[]
  /// Faqat "Бошқа" belgilanganda to'ldiriladi
  hunarmandchilik  String?
  zarurKomak       String[]
  issiqxonaTalabi  Boolean  @default(false)
  issiqxonaMaydoni Float?
  ijaraYer         Boolean  @default(false)
  ijaraYerMaydoni  Float?

  // ── X. PASSIV DAROMAD ──

  /// Оила пассив даромадга тайёрми.
  ///
  /// Иш ўрни ва тадбиркорликдан ФАРҚЛИ учинчи йўл. Ёши катта,
  /// соғлиғи заиф ёки бола парвариши билан банд аъзони ишга
  /// жойлаштириб бўлмайди — лекин мулкини ишлатиш мумкин.
  passivDaromadIstagi  Boolean  @default(false)
  passivDaromadTurlari String[]

  /// Ҳар бир восита учун МИҚДОР: `{ "Tovuq": 100, "Sigir": 1 }`.
  ///
  /// Миқдор каталогда эмас, шу ерда — чунки уни ФУҚАРО айтади.
  /// Илгари каталогда «100 та товуқ» деб турарди, яъни туман
  /// миқдорни олдиндан белгилаб қўйган бўларди. Амалда эса
  /// битта оилага 20 та товуқ етади, бошқасида катта ҳовли бор
  /// ва 300 тасини боқа олади.
  ///
  /// Нега `Json` ва алоҳида устун эмас: воситалар рўйхати
  /// ўзгаради (ҳоким кейинги йил янгисини қўшади), ҳар бири
  /// учун устун очиш эса миграция талаб қиларди.
  passivDaromadSonlari Json?
  /// «Бошқа» танланганда ёки қўшимча изоҳ
  passivDaromadIzohi   String?

  // ── XI. MAHALLA INFRATUZILMASI ──

  /// Маҳалладаги инфратузилма муаммолари.
  ///
  /// Анкетанинг қолган ҳамма бўлими ХОНАДОН ҳақида. Аммо оилани
  /// камбағалликдан чиқаришга тўсқинлик қиладиган нарса кўпинча
  /// хонадонда эмас, КЎЧАДА туради: йўл йўқ — маҳсулот бозорга
  /// чиқмайди; боғча йўқ — аёл ишга чиқолмайди; интернет йўқ —
  /// масофадан ишлаш мумкин эмас.
  ///
  /// 40 000 хонадондан йиғилганда бу туман учун тайёр
  /// инвестиция режаси бўлади.
  infratuzilmaMuammolari String[]
  /// «Бошқа» танланганда — қайси муаммо
  infratuzilmaBoshqa     String?
  /// Фуқаронинг ўз сўзи билан изоҳ
  infratuzilmaIzohi      String?

  // ── ESKI: XII-BO'LIM «XULOSA» ──
  //
  // Anketadan OLIB TASHLANGAN (2026-yil 16-sentabr, hokimiyat
  // talabi bilan). Mahalla xodimi bu katakni to'ldirmaydi va
  // xonadon sahifasida ham ko'rsatilmaydi.
  //
  // Ustunning o'zi bazada QOLDIRILDI: unda ilgari kiritilgan
  // yozuvlar bo'lishi mumkin va ularni o'chirish ma'lumot
  // yo'qotish demakdir. Yangi yozuvlarda u doim bo'sh bo'ladi.
  umumiyXulosa String?

  /// Tayyorlangan tavsiya - JSON matn sifatida:
  /// `{ manba, holat, tavsiyalar: [{ daraja, sarlavha, dalil }] }`.
  ///
  /// Alohida ustun ochilmadi: bu ma'lumot bo'yicha qidirilmaydi
  /// va sanalmaydi, u faqat o'qiladi. Shakli o'zgarsa, eski
  /// yozuv xom matn sifatida ko'rsatiladi - yo'qolmaydi.
  ///
  /// Xonadon ma'lumoti AI ga ISMSIZ yuboriladi: F.I.Sh., manzil,
  /// telefon va xodim yozgan HAR QANDAY erkin matn chiqarib
  /// tashlanadi, faqat sonlar va katalog qiymatlari qoladi.
  /// Shuning uchun bu matnda ham shaxs nomi bo'lmaydi.
  aiXulosa      String?
  aiXulosaVaqti DateTime?
  /// Qaysi usul ishlatilgani: 'ai' yoki 'qoida'
  aiManbasi     String?

  // ── ROZILIK VA IMZO ──
  /// Fuqaro ma'lumot yig'ilishiga rozi bo'lgani. Busiz yakuniy
  /// yuborish tugmasi ochilmaydi.
  rozilikBerdi Boolean   @default(false)
  /// Ekranda chizilgan imzo - SVG yo'l ma'lumoti sifatida.
  /// Rasm emas: yo'l bir necha kilobayt, PNG esa o'nlab. 40 ming
  /// xonadonda bu farq gigabaytlarga chiqadi.
  imzoYoli     String?
  imzoVaqti    DateTime?

  // ── Xizmat maydonlari ──
  xatlovSanasi DateTime @default(now())
  xodimId      String
  xodim        User     @relation(fields: [xodimId], references: [id], onDelete: Restrict)

  /// Takror xatlovni aniqlash uchun kalit: mahalla + manzil + oila
  /// boshlig'i, apostrof va bo'shliqlarsiz normallashtirilgan.

  // ── ARXIV ──
  //
  // Xatlov O'CHIRILMAYDI, arxivga olinadi.
  //
  // Sabab: `ActionPlan` va `HouseholdKesma` da `onDelete: Cascade`
  // turibdi. Haqiqiy o'chirish xonadon bilan birga uning
  // topshiriqlarini va butun tarixini ham jimgina yo'q qilardi —
  // va uni hech narsa qaytara olmasdi. 72 ta xodim ishlaydigan
  // tizimda bitta noto'g'ri bosish shunday oqibatga olib kelishi
  // mumkin emas.
  //
  // Arxivdagi yozuv hech qayerda ko'rinmaydi: ro'yxatda ham,
  // hisobotda ham, hokimning raqamlarida ham. Lekin administrator
  // uni qaytara oladi.
  /// Arxivga olingan sana. `null` — faol yozuv.
  arxivSanasi DateTime?
  arxivchiId  String?
  arxivSababi String?

  takrorKaliti String

  /// ============================================================
  ///  ИДЕМПОТЕНТЛИК КАЛИТИ
  ///
  ///  `takrorKaliti` МАЗМУН калити: манзил + оила бошлиғи.
  ///  Иккита ҳар хил ходим бир хонадонни киритса, у иккисида
  ///  ҳам БИР ХИЛ чиқади.
  ///
  ///  Бу эса ЮБОРИШ калити: браузер уни ҳар бир хатлов учун
  ///  бир марта яратади ва қайта юборишларда ўзгартирмайди.
  ///
  ///  Иккаласи бор бўлгани учун сервер 409 нинг сабабини
  ///  ажрата олади:
  ///
  ///    · мавжуд ёзувнинг калити БИЗНИКИ    → ўз юборишимиз
  ///      ўтиб кетган, жавоби келмаган. Такрор, зарари йўқ;
  ///
  ///    · калити бошқа ёки йўқ              → ҲАҚИҚИЙ зиддият.
  ///      Ходимнинг иши сақланмади ва уни ўчириб бўлмайди.
  ///
  ///  Илгари фарқ йўқ эди ва иккови ҳам «сақланди» деб
  ///  ҳисобланарди — ходимнинг бир соатлик иши жимгина
  ///  йўқоларди.
  ///
  ///  `null` бўлиши мумкин: эски ёзувларда ва серверда
  ///  яратилганларда (импорт, кўчириш) калит йўқ.
  /// ============================================================
  idempotentlikKaliti String? @unique

  /// ── КАЛИТ ҚАЙСИ АМАЛГА ТЕГИШЛИ ──
  ///
  /// Калитнинг ўзи етарли эмас эди. Қоралама ва якуний
  /// юбориш БИР ХИЛ калит билан келар, сервер эса амални
  /// солиштирмасдан «такрор» деб 200 қайтарар эди.
  ///
  /// Оқибати: алоқа узилиб қоралама жавоби йўқолса, ходим
  /// анкетани якунлаб юборганда сервер уни ЖИМГИНА рад
  /// этиб, «сақланди» деб жавоб берарди. Бутун анкета ва
  /// ишсизлар рўйхати йўқоларди.
  ///
  /// `qoralama` | `yakuniy`
  idempotentAmal String?

  /// Калитни КИМ яратган. Бошқа ходимнинг калити билан
  /// келган сўров ҳеч қачон унинг ёзувига тегмайди.
  idempotentUserId String?

  /// Мазмуннинг изи (SHA-256). Бир хил калит билан БОШҚА
  /// мазмун келса, бу «қайта юбориш» эмас — зиддият.
  idempotentIzi String?

  /// ── ПАРАЛЛЕЛ ТАҲРИР ──
  ///
  /// Икки ходим бир ёзувни очиб, кетма-кет сақласа,
  /// иккинчиси биринчисининг ўзгаришини ЖИМГИНА ўчириб
  /// юборарди — экранда эса иккаласига ҳам «сақланди»
  /// деб ёзиларди.
  ///
  /// Ҳар сақлашда рақам ошади. Мижоз ўзи очган рақамни
  /// қайтариб юборади; мос келмаса — 409 ва фарқлар
  /// кўрсатилади.
  versiya Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ishsizlar    UnemployedPerson[]
  topshiriqlar ActionPlan[]
  /// Oilaviy rivojlanish rejalari (tarixi bilan - faol bittagina)
  rejalar      OilaRejasi[]
  /// Vaqt kesimidagi holatlar - "yil boshida qanday edi"
  kesmalar     HouseholdKesma[]

  /// Bir xonadonni ikki marta kiritish mumkin emas
  @@unique([mahallaId, takrorKaliti])
  @@index([arxivSanasi])
  @@index([mahallaId, holati])
  @@index([xodimId])
  @@index([xatlovSanasi])
}

// ─────────────────────────────────────────────────────────────
//  ISHSIZ FUQARO - SHAXSIY ANKETA VA HAYOT SIKLI
// ─────────────────────────────────────────────────────────────

/// Ishsiz fuqaroning bandlik yo'lidagi holati.
///
/// Bu platformaning YURAGI. Hokim "nechta ishsiz bor" degan raqamni
/// allaqachon biladi (3 345). Unga kerak bo'lgani - shu 3 345 tadan
/// nechtasi qaysi bosqichda turgani.
enum IshsizHolati {
  /// Xonadon xatlovida aniqlangan, lekin hali suhbat bo'lmagan
  ANIQLANDI
  /// Bandlik mutaxassisi suhbat o'tkazdi va anketani to'ldirdi
  SUHBAT_OTKAZILDI
  /// Aniq taklif berildi (ish o'rni, YaTT, kredit, kurs...)
  TAKLIF_BERILDI
  /// Ishga joylashtirildi yoki o'z ishini boshladi
  JOYLASHTIRILDI
  /// Joylashtirilgani 3 oydan keyin tekshirildi va tasdiqlandi
  TASDIQLANDI
  /// Fuqaro taklifdan bosh tortdi - sababi yoziladi
  RAD_ETDI
}

model UnemployedPerson {
  id     String       @id @default(cuid())
  holati IshsizHolati @default(ANIQLANDI)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  // ── 3-4. Shaxsiy ma'lumot ──
  fish             String
  telefon          String?
  jinsi            String
  oilaviyHolat     String?
  farzandlarSoni   Int?
  millati          String?
  tugilganSana     DateTime?
  malumoti         String?
  mutaxassisligi   String?
  sogliqHolati     String?
  nogironlik       Boolean   @default(false)
  nogironlikGuruhi String?
  yashashManzili   String?

  // ── 4.10-4.18 ──
  kasbHunarEhtiyoji       Boolean   @default(false)
  organmoqchiKasb         String?
  ishTajribasiYil         Float?
  avvalgiIshJoyi          String?
  oxirgiIshJoyi           String?
  ishdanBoshaganSana      DateTime?
  xohlaganIsh             String?
  kutilayotganMaosh       BigInt?
  ishgaTayyorligi         String?
  haydovchilikGuvohnomasi Boolean   @default(false)
  haydovchilikToifasi     String[]

  /// IT-shaharchaga VAUCHER bilan yo'naltirilganmi.
  ///
  /// `takliflar` ro'yxatida ham "IT-shaharchaga yo'naltirish"
  /// bandi bor, lekin u SUHBAT natijasi - bandlik mutaxassisi
  /// to'ldiradi. Bu maydon esa XATLOV paytida, mahalla xodimi
  /// eshik oldida belgilaydi: fuqaro IT o'rganmoqchi ekan va
  /// IT-shaharchaga yo'naltirilsin.
  ///
  /// Bu ISTAK, vaucherning o'zi emas. Haqiqiy vaucher `ItVaucher`
  /// jadvalida - raqami, yo'nalishi va holati bilan. Ikkovi
  /// ataylab ajratilgan: bu yerda `true` turgan-u `ItVaucher`
  /// yozuvi yo'q odam - aynan ZANJIR UZILGAN joyi. Bandlik
  /// paneli shu ro'yxatni ko'rsatadi.
  itShaharchaVaucheri Boolean @default(false)

  /// Berilgan IT-shaharcha vaucherlari. Odatda bitta, lekin
  /// birinchisi bekor bo'lib ikkinchisi berilishi mumkin -
  /// shuning uchun ro'yxat.
  itVaucherlar    ItVaucher[]
  imtiyozEhtiyoji Boolean     @default(false)
  imtiyozTuri     String[]

  // ── 5. Bandlikni ta'minlash bo'yicha takliflar ──
  takliflar   String[]
  taklifIzohi String?
  /// XULOSA bo'limi
  xulosa      String?

  // ── Natija ──
  /// Qayerga joylashtirildi - e'londagi korxona nomi ko'chiriladi
  ishJoyi         String?
  ishLavozimi     String?
  ishgaKirganSana DateTime?
  /// Rad etgan bo'lsa - sababi
  radSababi       String?

  /// Qaysi E'LONGA joylashtirildi.
  ///
  /// `ishJoyi` erkin matn bo'lib qolaveradi: fuqaro e'lonsiz,
  /// o'zi topgan ishga ham joylashishi mumkin. Lekin e'lon orqali
  /// joylashtirilganda bu maydon to'ldiriladi va shundan keyingina
  /// "qaysi o'rin band bo'ldi", "e'londan nechta odam ishga
  /// kirdi" degan savollarga javob bor.
  vacancyId String?
  vacancy   Vacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  /// Маҳалла ходими юборган «иш топдим» хабарлари
  joylashuvXabarlari JoylashuvXabari[]

  /// Ishga joylashganini tasdiqlaydigan dalillar
  dalillar JoylashuvDalili[]

  // ── Suhbat o'tkazgan mutaxassis ──
  suhbatSanasi DateTime?
  mutaxassisId String?
  mutaxassis   User?     @relation(fields: [mutaxassisId], references: [id], onDelete: SetNull)

  /// Xonadonda birgalikda tushilgan rasm (anketa talabi)
  rasmUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── ARXIV ──
  //
  // Fuqaro ham o'chirilmaydi, arxivga olinadi: unga berilgan
  // topshiriqlar, IT-vaucher va joylashtirish tarixi yo'qolmasin.
  /// Arxivga olingan sana. `null` — faol yozuv.
  arxivSanasi DateTime?
  arxivchiId  String?
  arxivSababi String?

  topshiriqlar  ActionPlan[]
  /// Ишга жойлашиш ТАРИХИ — ҳар бир иш алоҳида воқеа
  joylashishlar IshgaJoylashish[]
  /// Ish o'rniga yo'llanmalari (rozilik bilan)
  yollanmalar   NomzodYollanmasi[]

  @@index([mahallaId, holati])
  @@index([holati])
  @@index([householdId])
  @@index([arxivSanasi])
  @@index([mutaxassisId])
  @@index([vacancyId])
}

// ─────────────────────────────────────────────────────────────
//  CHORA-TADBIRLAR REJASI
// ─────────────────────────────────────────────────────────────

enum TopshiriqHolati {
  KUTILMOQDA
  BAJARILMOQDA
  BAJARILDI
  /// Muddati o'tgan va bajarilmagan. Har kecha avtomatik belgilanadi.
  KECHIKDI
  BEKOR_QILINDI
}

/// Anketaning X/XI bo'limi: muammo -> sabab -> yechim -> mas'ul -> muddat.
///
/// Bu jadval platformani so'rovnomadan ISH YURITISH TIZIMIGA
/// aylantiradi. Hokim paneli "kechikkan topshiriqlar mas'ul tashkilot
/// kesimida" degan ko'rinishni aynan shundan oladi - va bu eng
/// kuchli hisobdorlik quroli.
model ActionPlan {
  id     String          @id @default(cuid())
  holati TopshiriqHolati @default(KUTILMOQDA)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  ishsizId String?
  ishsiz   UnemployedPerson? @relation(fields: [ishsizId], references: [id], onDelete: Cascade)

  muammo         String
  sababi         String?
  yechim         String
  masulTashkilot String
  muddat         DateTime

  bajarilganSana DateTime?
  natijaIzohi    String?

  yaratganId String
  yaratgan   User   @relation(fields: [yaratganId], references: [id], onDelete: Restrict)

  // ── OILA REJASINING QADAMI SIFATIDA ──
  //
  // Chora-tadbir ilgari yakka topshiriq edi. Oilaviy rejada u
  // QADAM: reja ichida turadi va unga zarur resurs hamda natija
  // dalili yoziladi. Hammasi IXTIYORIY — eski topshiriqlar
  // o'zgarmaydi va rejasiz ishlashda davom etadi.
  /// Qaysi oilaviy rejaning qadami (bo'lsa)
  rejaId       String?
  reja         OilaRejasi? @relation(fields: [rejaId], references: [id], onDelete: SetNull)
  /// Qadam uchun zarur xizmat yoki resurs
  zarurResurs  String?
  /// Natijani tasdiqlovchi dalil (hujjat, ma'lumotnoma, xabar...)
  natijaDalili String?
  /// Mas'ul XODIM (mas'ul tashkilotdan alohida)
  masulXodimId String?
  masulXodim   User?       @relation("ChoraMasulXodim", fields: [masulXodimId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([masulTashkilot, holati])
  @@index([muddat, holati])
  @@index([householdId])
  @@index([ishsizId])
  @@index([rejaId])
}

// ─────────────────────────────────────────────────────────────
//  OILAVIY RIVOJLANISH REJASI
// ─────────────────────────────────────────────────────────────

enum RejaHolati {
  /// Amalda - qadamlar bajarilmoqda
  FAOL
  /// Maqsadga erishildi yoki reja o'z vazifasini bajardi
  TUGALLANDI
  /// To'xtatildi: oila rad etdi, ko'chib ketdi yoki boshqa sabab
  TOXTATILDI
}

/// Oilaning ishlashi yoki daromad olishiga to'sqinlik qilayotgan sabab.
///
/// "Ishsiz" bitta sabab emas. Bolaga qaraydigan odami yo'q ona
/// bilan asbob-uskunasi yo'q usta - ikki xil yordam kerak. Sabablar
/// ro'yxati shu farqni bildiradi va "hammaga bir xil kurs" degan
/// xatoga yo'l qo'ymaydi.
enum RejaTosigi {
  TRANSPORT
  BOLAGA_QARASH
  ISH_JADVALI
  KONIKMA
  SOGLIQ_MOSLASHUVI
  MOS_ISH_SHAROITI
  ASBOB_USKUNA
  BUYURTMA_YETISHMASLIGI
  BOSHQA
}

/// Fuqaro bilan aloqa qanday bo'lgani
enum AloqaUsuli {
  TELEFON
  UCHRASHUV
  TASHRIF
}

/// OILANING RIVOJLANISH REJASI.
///
/// Xatlov oilaning holatini QAYD ETADI, chora-tadbir esa alohida
/// topshiriqlarni yozadi. Ularni bog'laydigan narsa yo'q edi: xodim
/// "bu oila bilan nima qilmoqchimiz va nega" degan savolga bitta
/// joydan javob ololmasdi.
///
/// ── Muhim chegara ──
///
/// Reja XODIM tomonidan yuritiladi. Oilaning fikri xodim orqali
/// qayd etiladi (`OilaAloqasi`) va u fuqaroning MUSTAQIL elektron
/// tasdig'i EMAS - shu sabab bu yerda "tasdiqlangan" degan maydon
/// yo'q. Fuqaro kabineti hozircha yo'q.
model OilaRejasi {
  id     String     @id @default(cuid())
  holati RejaHolati @default(FAOL)

  /// Bitta oilada bir vaqtda BITTA faol reja bo'lishi uchun.
  ///
  /// `holati = FAOL` bo'lganda `true`, boshqasida `null`. Postgres
  /// `null` larni bir-biridan farqli deb hisoblagani uchun
  /// (householdId, faolBelgi) juftligi faqat faol rejaga cheklov
  /// qo'yadi, tugaganlar esa cheksiz to'planadi. Ikki xodim bir
  /// vaqtda reja ochsa, ikkinchisini BAZA to'xtatadi.
  faolBelgi Boolean?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  /// Boshlang'ich holat - reja ochilgan paytdagi ahvol
  boshlangichHolat String
  /// Ma'lumot qayerdan olingan (masalan: "Xatlov, 12.09.2026")
  boshlangichManba String?
  /// Qaysi sanadagi holat. Qayd qilingan sana (`createdAt`) bilan
  /// bir narsa emas: xatlov oy oldin bo'lgan bo'lishi mumkin.
  boshlangichSana  DateTime @default(now())

  /// Oilaning O'ZI tanlagan maqsad (xodim yozib oladi)
  maqsad            String?
  /// Maqsad oila bilan kelishilganmi, yoki xodim taklif qilgan
  /// va hali muhokama qilinmagan
  maqsadKelishilgan Boolean @default(false)

  /// Mavjud ko'nikma va resurslar
  resurslar String?

  /// To'siqlar - ishlash yoki daromad olishga nima xalaqit beradi
  tosiqlar   RejaTosigi[]
  tosiqIzohi String?

  /// Mas'ul xodim va tashkilot
  masulXodimId   String?
  masulXodim     User?   @relation("RejaMasul", fields: [masulXodimId], references: [id], onDelete: SetNull)
  masulTashkilot String?

  /// Rejaning umumiy muddati
  muddat             DateTime?
  /// Zarur xizmat yoki resurs (qadamlarnikidan tashqari, umumiy)
  zarurResurs        String?
  /// Natijani tasdiqlovchi dalil (reja yopilganda)
  natijaDalili       String?
  /// Keyingi aloqa sanasi
  keyingiAloqaSanasi DateTime?

  yopilganSana  DateTime?
  yopilishIzohi String?

  yaratganId String
  yaratgan   User   @relation("RejaYaratgan", fields: [yaratganId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qadamlar ActionPlan[]
  aloqalar OilaAloqasi[]

  @@unique([householdId, faolBelgi], name: "bitta_faol_reja")
  @@index([householdId])
  @@index([holati, keyingiAloqaSanasi])
  @@index([masulXodimId])
}

/// Oila bilan aloqa yozuvi - telefon, uchrashuv yoki tashrif.
///
/// Ikki sana ataylab ajratilgan: `aloqaVaqti` - aloqa QACHON bo'lgan,
/// `createdAt` - yozuv QACHON kiritilgan. Xodim kechqurun kun davomidagi
/// uchta qo'ng'iroqni yozib qo'yishi mumkin; bu ikki sana farqli
/// bo'ladi va farqning o'zi ham ma'lumot.
model OilaAloqasi {
  id String @id @default(cuid())

  rejaId String
  reja   OilaRejasi @relation(fields: [rejaId], references: [id], onDelete: Cascade)

  usul       AloqaUsuli
  aloqaVaqti DateTime

  /// Oila vakili kim edi (masalan: "oila boshlig'i", "turmush o'rtog'i")
  kimBilan    String?
  /// Nima haqida gaplashildi - xodim bayoni
  mazmun      String
  /// Fuqaroning fikri - XODIM yozib olgan. Mustaqil tasdiq emas.
  fuqaroFikri String?

  qaydEtganId String
  qaydEtgan   User   @relation("AloqaQaydEtgan", fields: [qaydEtganId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([rejaId, aloqaVaqti])
  @@index([qaydEtganId])
}

// ─────────────────────────────────────────────────────────────
//  XABARNOMA - TELEGRAM
// ─────────────────────────────────────────────────────────────

/// Xabar nima haqida
enum XabarTuri {
  /// Mahallaga mos bo'sh ish o'rni e'loni chiqdi
  YANGI_ISH_ORNI
  /// IT-shaharcha vaucherini kutayotgan fuqaro bor
  VAUCHER_KUTMOQDA
  /// Chora-tadbir muddati yaqinlashdi yoki o'tdi
  TOPSHIRIQ_MUDDATI

  /// Mahalla xodimi «shu fuqaroga ish topdim» deb xabar qildi.
  /// Bandlik markaziga - tasdiqlash uchun.
  ISH_TOPILDI

  /// Bandlik markazi xabarni tasdiqladi, fuqaro rasman ishga
  /// joylashdi. Hokimga va xabar qilgan xodimga boradi.
  JOYLASHUV_TASDIQLANDI
  /// Bog'lashni tasdiqlash
  ULANISH

  /// Mahalla xodimi «bu fuqaro ishdan bosh tortdi» dedi.
  /// Bandlik markaziga - taklif mos kelmagan bo'lishi mumkin.
  FUQARO_RAD_ETDI

  /// Xodim Telegram ulanishini uzdi. Rahbar bilishi kerak:
  /// o'sha mahallaga e'lon xabari endi bormaydi.
  XODIM_UZILDI

  /// Hokimga va rahbarlarga har kuni ertalab ketadigan xulosa.
  /// Rahbar tizimga kirmaydi - shuning uchun tizim o'zi aytadi.
  ERTALABKI_BRIFING

  /// Yangi ish beruvchi ro'yxatdan o'tmoqchi — ko'rib chiqish kerak
  ISH_BERUVCHI_ARIZASI

  /// Ish beruvchi e'lon qo'ydi — moderatsiya kutmoqda
  ELON_MODERATSIYADA
}

/// Xabarning yo'li
enum XabarHolati {
  /// Navbatda, hali yuborilmagan
  KUTILMOQDA
  /// Telegram qabul qildi
  YUBORILDI
  /// Yuborib bo'lmadi - sababi `xatoMatni` da
  XATO
  /// Bekor qilindi (xodim bog'lanishni uzdi, e'lon yopildi...)
  BEKOR
}

/// Telegram orqali yuboriladigan xabar - NAVBAT va JURNAL.
///
/// ── Nega jadval kerak, to'g'ridan-to'g'ri yuborilmaydi ──
///
/// Telegram ishlamay turishi mumkin: server javob bermaydi,
/// internet uziladi, bot bloklanadi. Agar xabar to'g'ridan-
/// to'g'ri yuborilsa, u shunchaki YO'QOLADI va hech kim
/// bilmaydi - xodim esa "menga xabar kelmadi" deb aytmaydi,
/// chunki u xabar kutilganini ham bilmaydi.
///
/// Navbat jadvali buni ko'rsatadi: administrator panelida
/// "12 ta xabar yuborilmadi" deb turadi va sababi ham yozilgan.
///
/// ── Nega matn saqlanadi ──
///
/// Xabar yuborilgandan keyin ham matni qoladi: "xodimga nima
/// deb yozgan edik" degan savolga javob kerak bo'ladi.
model Xabarnoma {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  turi   XabarTuri
  holati XabarHolati @default(KUTILMOQDA)

  /// Yuboriladigan matn - Telegram HTML formatida
  matn String

  /// Nechta marta urinildi. Uch martadan keyin to'xtaydi:
  /// bot bloklangan bo'lsa, cheksiz urinish foydasiz.
  urinishlar Int @default(0)

  /// Nega yuborilmagani - administrator shuni o'qiydi
  xatoMatni String?

  yuborilganSana DateTime?

  /// Nima haqida - yozuvga qaytish uchun
  bogliqTuri String?
  bogliqId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([holati, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
//  XONADON TARIXI - KESMALAR
// ─────────────────────────────────────────────────────────────

/// Kesma nima sababdan olingani
enum KesmaSababi {
  /// Birinchi marta xatlovdan o'tdi
  ILK_XATLOV
  /// Qayta xatlov yoki tahrir - yuborilgan holatga qaytdi
  QAYTA_XATLOV
  /// Eski yozuvlar uchun bir martalik to'ldirish
  BOSHLANGICH
}

/// Xonadonning MA'LUM PAYTDAGI holati.
///
/// ── Nega kerak ──
///
/// `Household` jadvalida faqat OXIRGI holat turadi. Xatlov qayta
/// o'tkazilsa, eski raqamlar ustidan yozilib ketadi va "bu oila
/// yil boshida qanday edi" degan savolga javob qolmaydi.
///
/// Kambag'allikdan chiqishni o'lchash esa aynan shu savolga
/// tayanadi. Raqam o'sgani yetmaydi: xatlov davom etayotgani
/// uchun umumiy raqam baribir o'sadi. Kerakli savol boshqa -
/// "O'SHA OILA ilgarigidan yaxshiroq yashayaptimi".
///
/// ── Nega hamma ustun ko'chirilmaydi ──
///
/// `Household` da 160 dan ortiq maydon bor. Ularning ko'pi
/// o'zgarmaydi (manzil, oila boshlig'i ismi) yoki taqqoslashga
/// yaramaydi (izohlar, imzo). Shuning uchun bu yerda faqat
/// HARAKATDAGI ko'rsatkichlar alohida ustun bo'lib turadi -
/// ular bo'yicha SQL so'rov yozish mumkin.
///
/// To'liq yozuv esa `toliq` ichida JSON bo'lib saqlanadi: keyin
/// boshqa savol tug'ilsa, ma'lumot yo'qolmagan bo'ladi.
model HouseholdKesma {
  id String @id @default(cuid())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  /// Maхsus takrorlanadi: 70 ta mahalla xodimining izolyatsiyasi
  /// so'rovning o'zida, qo'shimcha JOIN'siz ta'minlanadi
  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  olinganSana DateTime    @default(now())
  sababi      KesmaSababi @default(QAYTA_XATLOV)

  // ── Oila tarkibi ──
  jamiAzo     Int
  bolalarSoni Int @default(0)

  // ── Mehnat va bandlik ──
  mehnatgaLayoqatli  Int @default(0)
  mehnatgaLayoqatsiz Int @default(0)
  ishlaydiganlar     Int @default(0)
  ishsizlarSoni      Int @default(0)

  // ── Daromad ──
  oylikDaromad      BigInt?
  /// `oylikDaromad / jamiAzo` - kambag'allikning asosiy o'lchovi.
  /// Alohida saqlanadi, chunki oila a'zolari soni ham o'zgaradi
  /// va keyinchalik qayta hisoblab bo'lmaydi.
  jonBoshigaDaromad BigInt?
  chetElOylikPulSom BigInt?

  // ── Xo'jalik ──
  yirikShoxliSoni Int?
  maydaShoxliSoni Int?
  parrandaSoni    Int?
  tomorqaMaydoni  Float?
  ekinMaydoni     Float?

  /// Томорқадан фойдаланиш даражаси — ўша кундаги баҳо.
  ///
  /// Кесмада сақланишининг сабаби шу: кейинги йил ўша хонадонга
  /// борилганда «ўтган сафар ёмон эди» деб КЎРСАТИШ мумкин
  /// бўлсин. Берилган ёрдам натижа бердими — шундан билинади.
  tomorqaFoydalanish String?

  qoshimchaYerMaydoni Float?

  // ── Yashash sharoiti ──
  gaz          Boolean @default(false)
  ichimlikSuvi String?
  uyHolati     String?

  // ── Istaklar ──
  tadbirkorlikIstagi Boolean @default(false)
  kasbHunarIstagi    Boolean @default(false)

  /// Nogironligi bo'lgan shaxslar soni
  nogironSoni Int @default(0)

  /// Anketa javoblaridan hisoblangan 0-100 oralig'idagi ko'rsatkich.
  ///
  /// DIQQAT: bu RASMIY kambag'allik mezoni EMAS va oilalarni
  /// bir-biri bilan taqqoslash uchun ham emas. U faqat BITTA
  /// oilani O'ZI bilan vaqt kesimida taqqoslash uchun xizmat
  /// qiladi: "shu xonadonda ahvol yaxshilandimi".
  ///
  /// Hisoblash usuli `src/lib/xonadon-tarixi.ts` da ochiq yozilgan
  /// va hisobotda ham ko'rsatiladi - yopiq formula bo'lmasligi
  /// kerak, aks holda unga ishonib bo'lmaydi.
  farovonlikBali Int

  /// O'sha paytdagi TO'LIQ yozuv - kelajakdagi savollar uchun
  toliq Json

  createdAt DateTime @default(now())

  @@index([householdId, olinganSana])
  @@index([mahallaId, olinganSana])
}

// ─────────────────────────────────────────────────────────────
//  IT-SHAHARCHA VAUCHERI
// ─────────────────────────────────────────────────────────────

/// Vaucherning yo'li: berildi -> o'qimoqda -> tugatdi -> ishga
/// joylashdi. Ikki chiqish yo'li ham bor va ular YASHIRILMAYDI:
/// hokim uchun eng muhim raqam "vaucher berildi, natija yo'q".
enum ItVaucherHolati {
  /// Vaucher yozildi, fuqaro hali kursni boshlamagan
  BERILDI
  /// Kursda o'qiyapti
  OQIMOQDA
  /// Kursni tugatdi, sertifikat oldi
  TUGATDI
  /// Kasb bo'yicha ishga joylashdi yoki o'z ishini boshladi
  ISHGA_JOYLASHDI
  /// Boshladi, lekin tashlab ketdi - sababi izohda
  TASHLAB_KETDI
  /// Bekor qilindi (fuqaro voz kechdi, guruh ochilmadi...)
  BEKOR_QILINDI
}

/// IT-shaharchada TEKINGA kasb o'rganish uchun beriladigan
/// vaucher.
///
/// Nega alohida jadval, `UnemployedPerson` dagi bitta belgi
/// yetmaydi:
///
///   - Belgi faqat "ha" deydi. Hokimning savoli esa boshqa:
///     "nechta vaucher berdik, nechtasi kursni tugatdi,
///     nechtasi ishga joylashdi va nechtasi bekorga ketdi".
///   - Yo'nalish kerak: sun'iy intellektga talab ko'pmi yoki
///     dizaynga - keyingi guruh shunga qarab ochiladi.
///   - Sana kerak: vaucher berilgandan keyin odam olti oy
///     qimirlamasa, bu KO'RINISHI kerak.
///
/// `mahallaId` ataylab takrorlanadi (fuqaroda ham bor): 70 ta
/// mahalla xodimi faqat o'zinikini ko'rishi shart, va bu
/// cheklov bitta ustunda, so'rovning o'zida turgani xavfsizroq
/// bo'ladi - qo'shimcha JOIN unutilib qolmaydi.
model ItVaucher {
  id     String          @id @default(cuid())
  /// Qog'ozdagi vaucher raqami: IT-2026-0001
  raqami String          @unique
  holati ItVaucherHolati @default(BERILDI)

  ishsizId String
  ishsiz   UnemployedPerson @relation(fields: [ishsizId], references: [id], onDelete: Cascade)

  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  /// `IT_YONALISHI` katalogidan. Fuqaroning o'z so'zi
  /// `organmoqchiKasb` da qoladi - bu esa shu istak qaysi
  /// guruhga tushishi.
  yonalish       String
  /// "Boshqa" tanlanganda yoziladi
  boshqaYonalish String?

  berilganSana    DateTime  @default(now())
  boshlanganSana  DateTime?
  tugatganSana    DateTime?
  ishgaKirganSana DateTime?

  /// Nima bo'lgani - ayniqsa tashlab ketgan va bekor qilinganda
  izoh String?

  bergangaId String
  bergan     User   @relation(fields: [bergangaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mahallaId, holati])
  @@index([holati, berilganSana])
  @@index([ishsizId])
}

// ─────────────────────────────────────────────────────────────
//  BO'SH ISH O'RINLARI
// ─────────────────────────────────────────────────────────────

/// Xatlovning X bo'limida mahalladagi tadbirkorlik subyektlari va
/// ulardagi bo'sh ish o'rinlari qayd etiladi. Bu jadval ularni
/// nomma-nom saqlaydi - moslashtirish taxtasi shunga tayanadi.
/// Bo'sh ish o'rni e'loni nega yopilgani
enum VacancyYopilishi {
  /// Barcha o'rinlar band bo'ldi - avtomatik yopildi
  TOLDI
  /// Xodim qo'li bilan yopdi (korxona voz kechdi, fikridan qaytdi...)
  QOLDA
  /// Amal qilish muddati tugadi - avtomatik yopildi
  MUDDATI_TUGADI
}

model Vacancy {
  id        String  @id @default(cuid())
  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  korxonaNomi String
  lavozim     String
  /// Kasb yo'nalishi - nomzod istagi bilan solishtirish uchun
  yonalish    String?
  ornlarSoni  Int     @default(1)
  maosh       BigInt?
  talablar    String?
  telefon     String?
  /// Ish jadvali (masalan: "Du-Sha 8:00-17:00", "smenali") - ixtiyoriy
  jadvali     String?
  /// Ish sharoiti (transport, ovqat, yotoqxona...) - ixtiyoriy
  sharoitlari String?

  /// E'lon qachongacha kuchda. Muddat o'tgach e'lon o'z-o'zidan
  /// yopiladi.
  ///
  /// ── Nega kerak bo'ldi ──
  ///
  /// Ilgari e'lon QO'LDA yopilmaguncha abadiy faol turardi.
  /// Korxona fikridan qaytsa yoki o'rinni boshqa yo'l bilan
  /// to'ldirsa, hech kim kelib e'lonni yopmasdi - va mahalla
  /// xodimlari allaqachon o'lgan e'lon bo'yicha odam yuborib
  /// yuraverardi. Fuqaro borib "bunday ish yo'q" deb qaytardi.
  ///
  /// Endi har e'lonning oxiri bor. Bo'sh qoldirilsa - muddatsiz,
  /// lekin shakl o'zi bir oy qo'yib beradi.
  amalQilishMuddati DateTime?

  /// E'LONNI KIM QO'YGAN.
  ///
  /// `null` - hokimiyat xodimi qo'ygan (sayt yoki bot orqali).
  /// To'ldirilgan bo'lsa - ish beruvchining o'zi qo'ygan va u
  /// moderatsiyadan o'tishi kerak.
  ishBeruvchiId String?
  ishBeruvchi   IshBeruvchi? @relation(fields: [ishBeruvchiId], references: [id], onDelete: SetNull)

  /// MODERATSIYA.
  ///
  /// ── Nega birlamchi qiymat TASDIQLANDI ──
  ///
  /// Migratsiya ustunni qo'shganda, eski kod hali ishlab
  /// turadi va u bu ustunni to'ldirmaydi. Birlamchi qiymat
  /// KUTILMOQDA bo'lsa, o'sha oradagi har bir e'lon jimgina
  /// ko'rinmay qolardi - xodim e'lon qo'yardi, xabar esa hech
  /// kimga bormasdi.
  ///
  /// Ish beruvchi qo'ygan e'londa KUTILMOQDA ANIQ yoziladi.
  moderatsiya ModeratsiyaHolati @default(TASDIQLANDI)

  /// ── КИМ, ҚАЧОН ва НЕГА ҲАЛ ҚИЛДИ ──
  ///
  /// Аввал эълон модерациясида фақат натижа сақланарди.
  /// «Бу эълонни ким рад этган?» деган саволга жавоб йўқ эди
  /// — ҳолбуки иш берувчи айнан шуни сўрайди.
  ///
  /// Иш берувчида (`IshBeruvchi`) бу маълумот аллақачон бор;
  /// эълонда ҳам бўлиши керак.
  moderatsiyaQilganId String?
  moderatsiyaQilgan   User?     @relation("ElonModeratsiyasi", fields: [moderatsiyaQilganId], references: [id], onDelete: SetNull)
  moderatsiyaSanasi   DateTime?
  /// Рад этилган бўлса — сабаби. Иш берувчига шу матн боради.
  moderatsiyaSababi   String?

  faol           Boolean           @default(true)
  /// Nega yopilgani. `faol = false` bo'lganda to'ldiriladi.
  ///
  /// Buni saqlash shart: o'rin to'lgani uchun avtomatik yopilgan
  /// e'lon joylashtirish bekor qilinsa QAYTA ochilishi kerak,
  /// xodim qo'li bilan yopgani esa ochilmasligi kerak. Sababsiz
  /// ikkalasi bir xil ko'rinardi.
  yopilishSababi VacancyYopilishi?
  yopilganSana   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Shu e'lon orqali ishga joylashtirilgan fuqarolar
  joylashganlar      UnemployedPerson[]
  joylashuvXabarlari JoylashuvXabari[]
  /// Шу эълон орқали жойлашганлар
  joylashishlar      IshgaJoylashish[]
  /// Shu ishga yo'llangan nomzodlar
  yollanmalar        NomzodYollanmasi[]

  @@index([moderatsiya])
  @@index([mahallaId, faol])
  @@index([yonalish, faol])
  @@index([faol, amalQilishMuddati])
}

// ─────────────────────────────────────────────────────────────
//  AUDIT JURNALI
// ─────────────────────────────────────────────────────────────

/// Kim qachon nimani ko'rgani va eksport qilgani.
///
/// Xatlov ma'lumotlari oila daromadi va sog'liq holatini o'z ichiga
/// oladi. Kim ularni ko'rgani yozib borilmasa, ma'lumot tarqalganda
/// javobgarni aniqlab bo'lmaydi.
model AuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// KIRISH, KORISH, YARATISH, OZGARTIRISH, EKSPORT, OCHIRISH
  amal       String
  obyektTuri String?
  obyektId   String?
  izoh       String?
  ip         String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([amal, createdAt])
}

/// Joylashuv xabarining holati
enum JoylashuvHolati {
  /// Mahalla xodimi xabar qildi, markaz hali ko'rmadi
  XABAR_QILINDI
  /// Markaz tasdiqladi - fuqaro rasman joylashtirildi
  TASDIQLANDI
  /// Markaz rad etdi - sababi yoziladi
  RAD_ETILDI
}

/// ============================================================
///  «ИШ ТОПДИМ» ХАБАРИ
///
///  Занжирнинг етишмаган ҳалқаси. Илгари шундай эди:
///
///    эълон → маҳалла ходимига хабар → ... → ҲЕЧ НАРСА
///
///  Ходим одамни ишга жойлаштирса ҳам, бу тизимга тушмасди:
///  унда жойлаштириш ҳуқуқи йўқ, Telegram эса бир томонлама
///  эди. Натижа маҳалла даражасида қолиб кетарди.
///
///  ── Нега алоҳида модел, тўғридан-тўғри жойлаштириш эмас ──
///
///  Расмий жойлаштириш — бандлик марказининг иши: ҳужжат,
///  шартнома, ҳисобот ўшанда. 70 та маҳалла ходими туман
///  рақамини бевосита ўзгартира олса, рақам ҳужжатсиз ўсиб
///  кетарди.
///
///  Шунинг учун ходимнинг тугмаси ХАБАР ёзади. Марказ уни
///  тасдиқлагач, мавжуд жойлаштириш мантиғи ишлайди ва
///  фуқаро расман ЖОЙЛАШТИРИЛДИ бўлади.
///
///  Ҳар ҳалқанинг ўз фойдаси бор: ходим дала билимини
///  киритади, марказ рақамни тасдиқлайди, ҳоким эса кутмасдан
///  кўради.
/// ============================================================
model JoylashuvXabari {
  id     String          @id @default(cuid())
  holati JoylashuvHolati @default(XABAR_QILINDI)

  vacancyId String
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  ishsizId String
  ishsiz   UnemployedPerson @relation(fields: [ishsizId], references: [id], onDelete: Cascade)

  /// Xabar qilgan mahalla xodimi
  xabarchiId String
  xabarchi   User   @relation("JoylashuvXabarchi", fields: [xabarchiId], references: [id], onDelete: Restrict)

  /// Markaz shu sanagacha tasdiqlashi kerak.
  /// O'tib ketsa - kechikkanlar ro'yxatiga tushadi va
  /// hokimning panelida ko'rinadi.
  muddat DateTime

  /// Tasdiqlagan yoki rad etgan mutaxassis
  halQilganId String?
  halQilgan   User?   @relation("JoylashuvHalQilgan", fields: [halQilganId], references: [id], onDelete: SetNull)

  halQilinganSana DateTime?
  /// Rad etilsa - sababi. Tasdiqlansa - qo'shimcha izoh.
  izoh            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bitta fuqaro bitta e'longa BIR MARTA xabar qilinadi.
  /// Tugma ikki marta bosilsa, ikkinchisi shu yerda to'xtaydi.
  @@unique([vacancyId, ishsizId])
  @@index([holati, muddat])
  @@index([xabarchiId, holati])
}

/// Botdagi ko'p qadamli suhbat holati.
///
/// Bot bir nechta savolni KETMA-KET beradi va oldingi
/// javoblarni eslab turishi kerak. Telegram esa har xabarni
/// alohida yuboradi - orada hech qanday "seans" yo'q.
///
/// Shuning uchun holat bazada: kim, qaysi bosqichda, nimalar
/// terilgan.
model BotSuhbati {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Qanday suhbat - hozircha faqat "ish-orni"
  turi String

  /// Qaysi savolda turibdi
  bosqich String

  /// Shu paytgacha terilganlar
  malumot Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/// Ishga joylashganlikni tasdiqlaydigan DALIL turi.
///
/// ── Nega tur kerak ──
///
/// Dalillarning kuchi bir xil emas. Davlat reyestridagi yozuv
/// bilan "mahalla xodimi ko'rdi" degan yozuv ikki xil narsa:
/// birinchisini tekshirib bo'ladi, ikkinchisiga faqat ishonish
/// mumkin.
///
/// Hisobotda ikkovi ham ko'rinadi, ammo AJRATIB: "19 tasidan
/// 7 tasi reyestr bilan tasdiqlangan" degan gap "19 tasi
/// tasdiqlangan" dan butunlay boshqacha.

/// ============================================================
///  ДАЛИЛ ҚАЕРДАН КЕЛГАН — ИШОНЧ ДАРАЖАСИ
///
///  ── Нега керак ──
///
///  Аввал қўлда юкланган Excel кўчирмасидан келган ёзув
///  ДАРҲОЛ «тасдиқланган» деб сақланарди — худди расмий
///  интеграциядан келгандек.
///
///  Аммо қўлда юкланган файлни ким, қачон ва қаердан
///  олганини тизим БИЛМАЙДИ. Уни таҳрирлаш ҳам, бошқа
///  файл билан алмаштириш ҳам мумкин.
///
///  Ҳокимликнинг энг муҳим рақами — «тасдиқланган
///  жойлаштириш» — шу ёзувлардан ҳисобланади. Демак
///  манбанинг ишончлилиги рақамнинг ишончлилиги.
/// ============================================================

/// ============================================================
///  ИШГА ЖОЙЛАШИШ ВОҚЕАСИ
///
///  ── Қандай нуқсонни ёпади ──
///
///  Далил ОДАМГА боғланган эди, ишга эмас. Оқибати:
///
///    2024: фуқаро «Оқ Олтин МЧЖ» га ишга кирди, шартнома
///          нусхаси киритилди ва ТАСДИҚЛАНДИ;
///    2025: у ишдан чиқди ва «Янги Йўл МЧЖ» га кирди.
///
///  Иккинчи иш учун ҳеч қандай далил йўқ эди-ю, одамда
///  «тасдиқланган далил бор» бўлиб турарди — яъни ЭСКИ
///  далил ЯНГИ ишни тасдиқлаб қўярди.
///
///  Ҳокимликнинг «тасдиқланган жойлаштириш» рақами шундан
///  ҳисобланади. Ёлғон чиқиши учун ҳеч ким ёмон ният
///  қилиши ҳам шарт эмас эди.
///
///  ── Нега алоҳида жадвал ──
///
///  `UnemployedPerson` да `ishJoyi` ва `ishgaKirganSana`
///  бор, аммо улар ФАҚАТ ОХИРГИ ишни сақлайди. Одам иш
///  алмаштирса, олдингиси изсиз ўчиб кетарди — ва
///  «нечта одам ишда қолди», «ўртача қанча ишлади» деган
///  саволларга жавоб бўлмасди.
///
///  Эски майдонлар ЎЗГАРТИРИЛМАДИ: хатлов ҳозир кетмоқда
///  ва уларга таянган ўнлаб сўров бор. Улар ОХИРГИ
///  воқеанинг қисқа нусхаси бўлиб қолаверади.
/// ============================================================
model IshgaJoylashish {
  id String @id @default(cuid())

  ishsizId String
  ishsiz   UnemployedPerson @relation(fields: [ishsizId], references: [id], onDelete: Cascade)

  /// Корхона номи — эркин матн. Фуқаро эълонсиз, ўзи топган
  /// ишга ҳам жойлашиши мумкин.
  korxonaNomi String
  lavozim     String?

  /// Рўйхатдаги иш берувчи — бор бўлса
  ishBeruvchiId String?
  ishBeruvchi   IshBeruvchi? @relation(fields: [ishBeruvchiId], references: [id], onDelete: SetNull)

  /// Қайси эълондан — бор бўлса
  vacancyId String?
  vacancy   Vacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  boshlanganSana DateTime
  tugaganSana    DateTime?
  tugashSababi   String?

  holati JoylashuvVoqeaHolati @default(NOMALUM)

  /// Ҳозирги ҳолат ҚАЧОН текширилган
  oxirgiTekshiruv DateTime?

  kiritganId String?
  kiritgan   User?   @relation("JoylashishKiritgan", fields: [kiritganId], references: [id], onDelete: SetNull)

  izoh String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dalillar JoylashuvDalili[]

  /// 30/60/90 kunlik kuzatuv tekshiruvlari
  kuzatuvlar KuzatuvTekshiruvi[]

  @@index([ishsizId, boshlanganSana])
  @@index([holati])
  @@index([vacancyId])
  @@index([ishBeruvchiId])
}

enum DalilManbasi {
  /// Ходим ўзи «иш топди» деб белгилади. Далил ЭМАС — хабар.
  XODIM_BILDIRDI
  /// Қўлда киритилган ҳужжат нусхаси (шартнома, буйруқ)
  QOLDA_HUJJAT
  /// Қўлда юкланган расмий кўчирма (Excel)
  QOLDA_REYESTR
  /// Текширилган интеграция орқали — ФАҚАТ шу автоматик тасдиқланади
  RASMIY_INTEGRATSIYA
}

/// ============================================================
///  ДАЛИЛ НИМАНИ ИСБОТЛАЙДИ
///
///  «Иш бошлагани» билан «ҳозир ҳам ишлаётгани» — ИККИ ХИЛ
///  савол ва уларга икки хил далил керак.
///
///  Шартнома нусхаси одам ишга КИРГАНИНИ кўрсатади. У бир
///  ойдан кейин ишдан чиққан бўлиши ҳам мумкин — шартнома
///  буни билмайди.
///
///  Аввал иккови фарқланмасди ва «барқарор бандлик» деган
///  кўрсаткични ҳисоблаб бўлмасди.
/// ============================================================
enum DalilMaqsadi {
  /// Иш БОШЛАГАНИ тасдиқланган
  ISH_BOSHLAGANI
  /// Ўша даврда ҲАМОН ишлаётгани текширилган
  HOZIR_ISHLAYOTGANI
}

/// Ишга жойлашиш воқеасининг ҳолати
enum JoylashuvVoqeaHolati {
  /// Ҳозир ишлаб турибди (ёки шундай деб ҳисобланади)
  ISHLAMOQDA
  /// Иш тугаган
  TUGADI
  /// Ҳозирги ҳолати текширилмаган
  NOMALUM
}

enum DalilTuri {
  /// Davlat reyestri ko'chirmasidan topildi - eng kuchli dalil
  REYESTR
  /// Mehnat shartnomasi nusxasi
  SHARTNOMA
  /// Ishga qabul qilish buyrug'i
  BUYRUQ
  /// Ish beruvchi yozma yoki telefon orqali tasdiqladi
  ISH_BERUVCHI
  /// Mahalla xodimi shaxsan ko'rdi
  MAHALLA
}

/// Dalilning tekshiruv holati.
enum DalilHolati {
  /// Kiritildi, mutaxassis hali ko'rmadi
  KIRITILDI
  /// Tekshirildi va to'g'ri
  TASDIQLANDI
  /// Tekshirildi - dalil yaroqsiz yoki mos kelmadi
  RAD_ETILDI
}

/// JOYLASHTIRISHNING DALILI.
///
/// ── Nega alohida jadval ──
///
/// "Ishga joylashtirildi" hozircha bitta bosish. Xodim tugmani
/// bosadi va tuman raqami bittaga oshadi. Hech kim tekshirmaydi.
///
/// Hokim esa o'sha raqamni yuqoriga hisobot qilib beradi. Agar
/// raqam noto'g'ri bo'lsa, u tuman darajasida noto'g'ri bo'ladi.
///
/// Dalil ALOHIDA jadvalda, chunki bitta joylashtirish bir necha
/// marta tasdiqlanadi: ishga kirgan kuni shartnoma bilan, uch
/// oydan keyin reyestr bilan. Fuqaro yozuvidagi bitta maydon
/// buni ko'tara olmaydi - ikkinchi dalil birinchisini
/// o'chirib yuborardi.
model JoylashuvDalili {
  id     String      @id @default(cuid())
  turi   DalilTuri
  holati DalilHolati @default(KIRITILDI)

  ishsizId String
  ishsiz   UnemployedPerson @relation(fields: [ishsizId], references: [id], onDelete: Cascade)

  /// ── ҚАЙСИ ИШГА ТЕГИШЛИ ──
  ///
  /// Аввал далил фақат ОДАМГА боғланган эди. Одам иш
  /// алмаштирса, эски ишнинг тасдиқланган далили ЯНГИ
  /// ишни ҳам тасдиқлаб турарди.
  ///
  /// `null` бўлиши мумкин: шу устун қўшилгунга қадар
  /// киритилган далилларда воқеа йўқ. Улар «боғланиши
  /// керак» деган рўйхатга тушади — тахмин қилиб,
  /// ўзимиз боғлаб қўймаймиз.
  joylashishId String?
  joylashish   IshgaJoylashish? @relation(fields: [joylashishId], references: [id], onDelete: SetNull)

  /// ── ДАЛИЛ ҚАЕРДАН КЕЛГАН ──
  ///
  /// Ишонч даражаси шу ердан бошланади. Фақат
  /// `RASMIY_INTEGRATSIYA` автоматик тасдиқланади.
  manbaTuri DalilManbasi @default(QOLDA_HUJJAT)

  /// Ҳужжатни берган ташкилот (бор бўлса)
  manbaTashkilot String?
  /// Ҳужжатнинг ЎЗИДАГИ сана — киритилган сана эмас
  hujjatSanasi   DateTime?

  /// Далил ҚАЙСИ ДАВРНИ қамрайди
  davrBoshi DateTime?
  davrOxiri DateTime?

  /// Қайси юклашдан келган — бир файлни бир бутун кўриш учун
  importId String?

  /// Файлнинг криптографик изи (SHA-256).
  ///
  /// ДИҚҚАТ: из файлнинг ЎЗГАРМАГАНИНИ кўрсатади, ҲАҚИҚИЙ
  /// эканини ЭМАС. Сохта файл ҳам барқарор изга эга бўлади.
  /// У «шу ёзув ўша файлдан» деган боғни сақлайди, холос.
  faylIzi String?

  /// Далил НИМАНИ исботлайди
  maqsadi DalilMaqsadi @default(ISH_BOSHLAGANI)

  /// Reyestr ko'chirmasidagi ish beruvchi nomi.
  ///
  /// Solishtirish uchun saqlanadi: tizimda "Oq Oltin MChJ"
  /// yozilgan bo'lib, reyestrda boshqa korxona chiqsa - bu
  /// xato emas, HODISA. Fuqaro boshqa joyga ishga kirgan va
  /// buni hech kim yozmagan.
  reyestrIshJoyi String?
  /// Reyestr ko'chirmasi qaysi sanaga tegishli
  reyestrSanasi  DateTime?

  /// Qo'shimcha izoh yoki hujjat raqami
  izoh String?

  /// Dalilni kim kiritdi
  kiritganId String?
  kiritgan   User?   @relation("DalilKiritgan", fields: [kiritganId], references: [id], onDelete: SetNull)

  /// Shu dalilga tayangan kuzatuv tekshiruvlari
  kuzatuvlar KuzatuvTekshiruvi[]

  /// Kim tekshirdi
  tasdiqlaganId    String?
  tasdiqlagan      User?     @relation("DalilTasdiqlagan", fields: [tasdiqlaganId], references: [id], onDelete: SetNull)
  tasdiqlanganSana DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ── БИР ОДАМГА, БИР САНАГА, БИТТА РЕЕСТР ДАЛИЛИ ──
  ///
  /// Такрорни аввал КОД текширарди: юклашдан олдин «шу
  /// санадаги далил борми» деб сўраларди. Иккита оқибати
  /// бор эди:
  ///
  ///   · битта файлда бир одам икки сатрда турса (расмий
  ///     кўчирмаларда оддий ҳол), иккови ҳам ўтиб кетарди —
  ///     текширув сикл БОШИДА бир марта бўларди;
  ///
  ///   · иккита администратор файлни бир вақтда юкласа,
  ///     иккови ҳам «йўқ экан» деб кўрар ва иккови ҳам
  ///     ёзарди.
  ///
  /// Энди чегара БАЗАНИНГ ўзида. Код ҳам текшириб туради —
  /// бу иккинчи қават ва ходимга тушунарли хабар беради.
  ///
  /// `turi` ҳам калитда: қўлда киритилган шартнома билан
  /// реестр далили ҳар хил нарса ва улар ёнма-ён турса
  /// бўлади.
  @@unique([ishsizId, turi, reyestrSanasi], name: "dalil_takrori")
  @@index([ishsizId, holati])
  @@index([turi, holati])
  @@index([createdAt])
  @@index([joylashishId])
  @@index([importId])
  @@index([manbaTuri, holati])
}

/// Ish beruvchining ro'yxatdan o'tish holati.
enum IshBeruvchiHolati {
  /// Ariza yuborildi, bandlik markazi hali ko'rmadi
  KUTILMOQDA
  /// Tasdiqlandi - endi e'lon qo'ya oladi
  TASDIQLANDI
  /// Rad etildi - sababi yoziladi
  RAD_ETILDI
}

/// E'lonning moderatsiya holati.
///
/// ── Nega kerak ──
///
/// E'lon 70 ta mahalla xodimiga xabar yuboradi va tuman
/// hisobotiga kiradi. Ish beruvchi esa hokimiyat xodimi emas:
/// uning yozganini hech kim ko'rmasdan tarqatib bo'lmaydi.
enum ModeratsiyaHolati {
  KUTILMOQDA
  TASDIQLANDI
  RAD_ETILDI
}

/// ISH BERUVCHI - bot orqali e'lon qo'yadigan korxona.
///
/// ── Nega alohida jadval, User emas ──
///
/// Ish beruvchini `User` qilib qo'yish oson edi: telegram
/// ulanishi, suhbat holati va xabar navbati tayyor turibdi.
///
/// Qilinmadi. `User` - bu SAYTGA kiradigan odam, va uning roli
/// o'nlab joyda tekshiriladi. Yangi rol qo'shilsa, o'sha
/// o'nlab tekshiruvning har biri "bu rol bilan nima qilamiz"
/// degan savolga javob berishi kerak bo'lardi - va bittasi
/// esdan chiqsa, tashqaridagi odam ichkaridagi ma'lumotni
/// ko'rib qolardi.
///
/// Alohida jadvalda bu xavf UMUMAN yo'q: ish beruvchining
/// sayt sessiyasi ham, paroli ham yo'q.
model IshBeruvchi {
  id             String            @id @default(cuid())
  telegramChatId String            @unique
  holati         IshBeruvchiHolati @default(KUTILMOQDA)

  korxonaNomi String
  masulShaxs  String
  telefon     String

  /// Korxona qaysi MFY hududida
  mahallaId String?
  mahalla   Mahalla? @relation(fields: [mahallaId], references: [id], onDelete: SetNull)

  /// Rad etilsa - sababi. Ish beruvchi buni botda ko'radi.
  radSababi String?

  /// Kim ko'rib chiqdi
  halQilganId     String?
  halQilgan       User?     @relation("IshBeruvchiHalQilgan", fields: [halQilganId], references: [id], onDelete: SetNull)
  halQilinganSana DateTime?

  /// Botdagi ko'p qadamli suhbat holati.
  ///
  /// `BotSuhbati` jadvali ishlatilmadi: u `User` ga bog'langan
  /// va ish beruvchi User emas. Suhbat shu yerda - bitta ish
  /// beruvchida bir vaqtda bitta suhbat bo'ladi.
  bosqich     String?
  suhbat      Json      @default("{}")
  suhbatVaqti DateTime?

  elonlar Vacancy[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  /// Шу корхонага жойлашганлар
  joylashishlar IshgaJoylashish[]

  @@index([holati])
}

// ─────────────────────────────────────────────────────────────
//  ТЕЛЕГРАМ ЯНГИЛАНИШЛАРИ — ТАКРОРНИ ТЎСИШ УЧУН
// ─────────────────────────────────────────────────────────────

/// Telegram жавоб ололмаса ЎША янгиланишни қайта юборади.
///
/// Бу оддий ҳол: тармоқ узилди, деплой пайтига тўғри келди,
/// сервер секин жавоб берди. Ҳимоясиз бўлса, бир «тасдиқлаш»
/// тугмаси икки марта ишлар, бир эълон икки марта тарқатилар
/// эди.
///
/// `updateId` — бирламчи калит. Текширув ЁЗИШ орқали
/// бажарилади: иккита сервер нусхаси бир вақтда ишлаганда
/// «борми?» деган савол иккаласига ҳам «йўқ» дейиши мумкин,
/// ягоналик чегараси эса фақат биттасини ўтказади.
///
/// Эски ёзувлар жадвал бўйича тозаланади — Telegram бир
/// суткадан кейин қайта юбормайди.
model TelegramYangilanish {
  updateId  BigInt   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
//  30/60/90 KUNLIK KUZATUV
// ─────────────────────────────────────────────────────────────

/// Kuzatuv savoliga javob. `NOMALUM` - "so'ralmagan yoki bilib bo'lmadi";
/// u `YOQ` (aniq "yo'q") dan butunlay boshqa narsa.
enum KuzatuvJavobi {
  HA
  YOQ
  NOMALUM
}

/// Ma'lumot QAYDAN ekani. Hisobotda to'rt ustun shu bilan ajraladi.
///
///  NOMALUM          - bilib bo'lmadi
///  XODIM_QAYD_ETGAN - xodim o'zi ko'rdi yoki o'z hisobidan yozdi
///  FUQARO_BILDIRGAN - fuqaroning o'zi aytdi (xodim yozib oldi)
///  TEKSHIRILGAN     - hujjat yoki rasmiy manba bilan tasdiqlangan
///                     (tasdiqlangan DALIL bilan bog'langan bo'lishi shart)
enum MalumotDarajasi {
  NOMALUM
  XODIM_QAYD_ETGAN
  FUQARO_BILDIRGAN
  TEKSHIRILGAN
}

enum KuzatuvNatijasi {
  /// Fuqaro yoki manba bilan bog'lanildi, javoblar yozildi
  MALUMOT_OLINDI
  /// Bog'lanishga urinildi, ma'lumot olinmadi. Muddat bajarilgan
  /// hisoblanmaydi: "ishda qoldi" ham, "ketdi" ham emas.
  BOGLANILMADI
}

/// Ishga joylashishdan keyingi 30, 60 va 90-kun tekshiruvi.
///
/// Mavjud "uch oylik nazorat" bitta topshiriq edi: "bog'lanib
/// ishlayotganini aniqlang". Natija esa matn, hisoblab bo'lmaydi.
/// Bu jadval savollarni ajratadi va har javobning MANBAINI yozadi.
///
/// ── To'rt xil sana ataylab ajratilgan ──
///
///  ishga kirgan sana     - `IshgaJoylashish.boshlanganSana`
///  ma'lumot olingan sana - `tekshiruvSanasi` (fuqaro bilan qachon gaplashildi)
///  tasdiq sanasi         - `tasdiqSanasi` (TEKSHIRILGAN bo'lganda)
///  kiritilgan sana       - `createdAt`
model KuzatuvTekshiruvi {
  id String @id @default(cuid())

  joylashishId String
  joylashish   IshgaJoylashish @relation(fields: [joylashishId], references: [id], onDelete: Cascade)

  /// 30, 60 yoki 90
  kunBelgisi Int
  /// Muddat: ishga kirgan sanaga `kunBelgisi` kun qo'shilgan
  rejaSana   DateTime

  natija KuzatuvNatijasi

  /// Ma'lumot QACHON olingan (kiritilgan sana emas)
  tekshiruvSanasi DateTime
  /// Tekshirilgan (hujjat bilan) deb belgilangan sana
  tasdiqSanasi    DateTime?

  /// Javoblarning umumiy manbasi
  manba MalumotDarajasi @default(NOMALUM)

  ishBoshladi     KuzatuvJavobi @default(NOMALUM)
  ishdaQolmoqda   KuzatuvJavobi @default(NOMALUM)
  /// Kelishilgan ish haqini olayaptimi
  haqOlmoqda      KuzatuvJavobi @default(NOMALUM)
  /// Ish sharoiti mosmi
  sharoitMos      KuzatuvJavobi @default(NOMALUM)
  qoshimchaYordam KuzatuvJavobi @default(NOMALUM)

  /// Oylik ish haqi, so'mda. `null` - NOMA'LUM. 0 - rostdan 0.
  ishHaqiSom        BigInt?
  /// Oilaning hozirgi oylik daromadi, so'mda. `null` - noma'lum.
  oilaDaromadiSom   BigInt?
  /// Taqqoslash uchun BOSHLANG'ICH daromad (ishga joylashishdan oldingi), so'mda.
  /// Odatda xatlovdagi qiymat; xodim o'zgartirishi mumkin. `null` - noma'lum.
  /// O'zgarish faqat IKKALASI ham ma'lum bo'lganda hisoblanadi.
  oldingiDaromadSom BigInt?
  /// Daromad raqamlari manbasi (umumiy manbadan farq qilishi mumkin)
  daromadManbasi    MalumotDarajasi @default(NOMALUM)

  /// Ish tugagan bo'lsa - sababi
  tugashSababi String?
  /// Qanday qo'shimcha yordam kerakligi
  yordamIzohi  String?

  /// TEKSHIRILGAN uchun - tayanilgan tasdiqlangan dalil
  dalilId String?
  dalil   JoylashuvDalili? @relation(fields: [dalilId], references: [id], onDelete: SetNull)

  /// BOGLANILMADI bo'lsa - qachon qayta urinish
  qaytaUrinishSanasi DateTime?

  kiritganId String
  kiritgan   User   @relation(fields: [kiritganId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bitta ish uchun har bosqichga BITTA yozuv
  @@unique([joylashishId, kunBelgisi], name: "kuzatuv_bosqichi")
  @@index([kunBelgisi, natija])
  @@index([rejaSana])
  @@index([kiritganId])
  @@index([dalilId])
}

// ─────────────────────────────────────────────────────────────
//  NOMZODNI ISH BERUVCHIGA YO'LLASH
// ─────────────────────────────────────────────────────────────

enum YollanmaHolati {
  /// Yo'llanma yozildi
  YOLLANDI
  /// Ish beruvchi suhbat belgiladi
  SUHBAT_BELGILANDI
  /// Suhbat o'tkazildi
  SUHBAT_OTKAZILDI
  /// Ish beruvchi ishga qabul qilganini bildirdi (TASDIQ EMAS - joylashish
  /// voqeasi va dalil alohida yoziladi)
  ISHGA_QABUL
  /// Ish beruvchi nomzod mos kelmaganini bildirdi
  ISH_BERUVCHI_RAD
  /// Fuqaro o'zi voz kechdi
  FUQARO_RAD
  /// Xodim bekor qildi
  BEKOR
}

/// Fuqarodan rozilik qanday olingani
enum RozilikUsuli {
  OGZAKI
  TELEFON
  YOZMA
}

/// Natija kimdan ekani. Ish beruvchining gapi xodim tekshirguncha
/// "bildirilgan"dir, tasdiq emas.
enum YollanmaManbasi {
  XODIM_QAYD_ETGAN
  ISH_BERUVCHI_BILDIRGAN
}

/// Ishsiz fuqaroni bo'sh ish o'rniga yo'llash.
///
/// ── Rozilik ──
///
/// Fuqaroning telefoni va ismi ish beruvchiga FAQAT u rozi bo'lgach
/// beriladi, va faqat zarur minimum (`ulashilgan`). Rozilik xodim
/// tomonidan yozib olinadi (usuli va sanasi bilan) va fuqaroning
/// mustaqil elektron tasdig'i emas.
///
/// ── Natija tasdiq emas ──
///
/// Ish beruvchi "ishga qabul qildik" desa, bu `ISHGA_QABUL` bo'ladi, ammo
/// "tasdiqlangan joylashish" HISOBLANMAYDI: u joylashish voqeasi va
/// dalil orqali alohida tasdiqlanadi.
model NomzodYollanmasi {
  id String @id @default(cuid())

  ishsizId String
  ishsiz   UnemployedPerson @relation(fields: [ishsizId], references: [id], onDelete: Cascade)

  vacancyId String
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  holati YollanmaHolati @default(YOLLANDI)

  /// Ish beruvchiga ma'lumot berishga fuqaro roziligi
  rozilik       Boolean       @default(false)
  roziligiSana  DateTime?
  roziligiUsuli RozilikUsuli?

  /// Ish beruvchiga qaysi maydonlar yuborilgani (fish, telefon, kasb)
  ulashilgan     String[]
  ulashilganSana DateTime?

  suhbatSanasi  DateTime?
  natijaIzohi   String?
  natijaManbasi YollanmaManbasi?
  natijaSanasi  DateTime?

  yaratganId String
  yaratgan   User   @relation("YollanmaYaratgan", fields: [yaratganId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bitta nomzod bitta ishga bir marta yo'llanadi
  @@unique([ishsizId, vacancyId], name: "yollanma_takrori")
  @@index([vacancyId, holati])
  @@index([holati, ulashilganSana])
  @@index([yaratganId])
}
