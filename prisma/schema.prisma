// ============================================================
//  XATIRCHI TUMANI - BANDLIK PLATFORMASI
//  Ma'lumotlar bazasi: PostgreSQL (Supabase bilan mos)
//
//  Uchta asosiy obyekt bir-biriga zanjir bo'lib ulanadi:
//
//    MAHALLA ──▶ XONADON ──▶ ISHSIZ FUQARO ──▶ CHORA-TADBIR
//    (baza)      (xatlov)     (shaxsiy anketa)   (topshiriq)
//
//  MAHALLA baza raqamlarini saqlaydi (svod jadvalidan) - ular
//  qamrov foizining maxraji. XONADON ishsizlarni TOPADI, ISHSIZ
//  FUQARO ular bilan ISHLAYDI, CHORA-TADBIR esa kim nima qilishi
//  kerakligini va muddatini yozib qo'yadi.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
//  ROLLAR VA FOYDALANUVCHILAR
// ─────────────────────────────────────────────────────────────

enum Rol {
  /// Mahalla yettiligi a'zosi - xonadonlarni xatlovdan o'tkazadi.
  /// FAQAT o'z mahallasini ko'radi.
  YETTILIK

  /// Bandlikka ko'maklashish markazi xodimi - ishsizlar bilan
  /// suhbat o'tkazadi, taklif beradi, joylashtiradi. Butun tumanni ko'radi.
  BANDLIK

  /// Bandlik markazi rahbari - operatsion panel va tayinlash huquqi
  BANDLIK_RAHBAR

  /// Tuman hokimi va o'rinbosarlari - faqat tahlil paneli, o'zgartirmaydi
  HOKIM

  /// Tizim administratori - foydalanuvchi yaratadi, kataloglarni boshqaradi
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  /// Kirish uchun login - lotin harflar va raqamlar
  username     String  @unique
  /// scrypt hash: "salt:hash" ko'rinishida
  passwordHash String
  fullName     String
  /// Lavozimi - anketadagi imzo qatorida chiqadi
  position     String?
  phone        String?
  rol          Rol

  /// YETTILIK roli uchun MAJBURIY - xodim faqat shu mahallani ko'radi.
  /// Boshqa rollar uchun bo'sh (ular butun tumanni ko'radi).
  mahallaId String?
  mahalla   Mahalla? @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  /// Faol emas qilingan xodim tizimga kira olmaydi, lekin uning
  /// yozuvlari saqlanib qoladi (o'chirish tarixni buzardi).
  faol Boolean @default(true)

  /// Administrator tayinlagan oxirgi parol - SHIFRLANGAN holda.
  ///
  /// Bazani ochgan odam faqat tushunarsiz belgilar ko'radi;
  /// ochish uchun ilovaning `SESSION_SECRET` i ham kerak.
  ///
  /// Kirish paroli bundan MUSTAQIL: u scrypt bilan xeshlangan va
  /// hech qachon orqaga o'qilmaydi. Bu maydon faqat "qanday parol
  /// berganimni ko'ray" degan ehtiyoj uchun.
  berilganParol String?

  /// Parol oxirgi marta qachon tayinlangani
  parolBerilganVaqt DateTime?

  /// Parolni birinchi kirishda almashtirish talab qilinadimi.
  ///
  /// Ikkinchi vazifasi ham bor: `berilganParol` hali amaldami
  /// yoki yo'qmi - shuni bildiradi. `true` bo'lsa xodim hali
  /// o'zgartirmagan, ya'ni saqlangan parol to'g'ri. `false`
  /// bo'lsa xodim o'z parolini qo'ygan va saqlangani ESKIRGAN.
  parolAlmashtirilsin Boolean @default(true)

  // ── TELEGRAM ──

  /// Telegram chat ID - xabar aynan shu raqamga yuboriladi.
  ///
  /// Xodim o'zi bog'laydi: ilovadan bir martalik kod oladi va
  /// uni botga yuboradi. Administrator qo'lda kirita olmaydi -
  /// noto'g'ri raqam kiritilsa, xabar BEGONA odamga ketardi.
  telegramChatId String? @unique

  /// Qachon bog'langani - xodim "bog'langanmi?" degan savolga
  /// javob ko'rishi uchun
  telegramSana DateTime?

  /// Bog'lash uchun bir martalik kod. Ishlatilgach tozalanadi.
  telegramKodi String? @unique

  /// Kod qachon berilgani - eskirgan kod qabul qilinmaydi
  telegramKodiVaqti DateTime?

  oxirgiKirish DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  xatlovlar          Household[]
  suhbatlar          UnemployedPerson[]
  topshiriqlar       ActionPlan[]
  auditYozuvlar      AuditLog[]
  itVaucherlar       ItVaucher[]
  xabarlar           Xabarnoma[]
  joylashuvXabarlari JoylashuvXabari[]  @relation("JoylashuvXabarchi")
  joylashuvHalQilgan JoylashuvXabari[]  @relation("JoylashuvHalQilgan")

  @@index([rol, faol])
  @@index([mahallaId])
}

// ─────────────────────────────────────────────────────────────
//  MAHALLA - KATALOG VA BAZA STATISTIKASI
// ─────────────────────────────────────────────────────────────

/// 70 ta MFY. Raqamlar 31.08.2026 svod jadvalidan olinadi va
/// qamrov foizini hisoblashda MAXRAJ bo'lib xizmat qiladi.
model Mahalla {
  id         String @id @default(cuid())
  tartib     Int    @unique
  nomi       String @unique
  nomiKirill String

  /// Mahallada xatlov uchun MAS'UL shaxs - hokim yordamchisi.
  ///
  /// Ilgari bu maydonlar MFY RAISINI saqlardi va nomi ham shunday
  /// edi (`raisFish`). Amalda esa xatlovni rais emas, hokim
  /// yordamchisi kiritadi: rais saylanadigan jamoat vakili, hokim
  /// yordamchisi esa shu ish uchun tayinlangan mansabdor.
  ///
  /// Nomi ataylab o'zgartirildi: "rais" deb qolsa, keyin kod
  /// o'qigan odam bu maydonda MFY raisi turgan deb o'ylardi va
  /// uning telefoniga qo'ng'iroq qilardi.
  /// Lavozim BO'SH bo'lishi mumkin (rasmiy ro'yxatda "Вакант"),
  /// shuning uchun null qabul qiladi. Bo'sh qiymatni "—" yoki
  /// bo'sh satr bilan to'ldirish mumkin edi, lekin unda "hali
  /// tayinlanmagan" va "kiritilmagan" holatlari qo'shilib ketardi.
  masulFish     String?
  masulTelefon  String?
  /// 'Ҳоким ёрдамчиси' - lavozim nomi o'zgarishi mumkin, shuning
  /// uchun qat'iy emas, matn sifatida saqlanadi
  masulLavozimi String

  aholi   Int
  xonadon Int
  oila    Int

  kambagalYanvar         Int
  kambagalJami           Int
  davlatTaminotida       Int
  kambagalOilalar        Int
  kambagallikChegarasida Int

  mehnatgaLayoqatli Int
  band              Int
  /// Ro'yxatdagi ishsizlar soni - qamrov foizining maxraji
  ishsiz            Int

  ayollarDaftari       Int
  ijtimoiyReestr       Int
  migratsiyadanQaytgan Int
  oliyBitiruvchi       Int
  ortaMaxsusBitiruvchi Int
  maktabBitiruvchi     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  xodimlar     User[]
  xonadonlar   Household[]
  ishsizlar    UnemployedPerson[]
  ishOrinlar   Vacancy[]
  itVaucherlar ItVaucher[]
  kesmalar     HouseholdKesma[]

  @@index([nomi])
}

// ─────────────────────────────────────────────────────────────
//  XONADON XATLOVI - 11 BO'LIM
// ─────────────────────────────────────────────────────────────

enum XatlovHolati {
  /// Qoralama - xodim to'ldirishni boshlagan, lekin tugatmagan.
  /// Telefon o'chsa yoki xonadon egasi band bo'lsa, keyin davom etadi.
  QORALAMA
  /// Yuborilgan - to'liq to'ldirilgan va tekshiruvdan o'tgan
  YUBORILGAN
  /// Tasdiqlangan - bandlik markazi ko'rib chiqqan
  TASDIQLANGAN
}

model Household {
  id     String       @id @default(cuid())
  holati XatlovHolati @default(QORALAMA)

  viloyat   String  @default("Navoiy")
  tuman     String  @default("Xatirchi")
  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  /// Xonadon manzili - takror xatlovni aniqlashda ishlatiladi
  manzil String

  // ── Oila boshlig'i ──
  oilaBoshligi             String
  /// Oila boshlig'i jinsi. Nafaqa yoshi ayol va erkak uchun
  /// har xil (55/60), shuning uchun yosh tekshiruvi busiz
  /// ishlamaydi.
  oilaBoshligiJinsi        String?
  /// Oila boshlig'ining tug'ilgan SANASI.
  ///
  /// Ilgari faqat `tugilganYili` (yil) so'ralardi, ishsiz fuqaroda
  /// esa to'liq sana - bir tushuncha ikki shaklda edi. Xodim oila
  /// boshlig'ini ishsizlar ro'yxatiga ham qo'shganda sanani
  /// qaytadan terishi kerak bo'lardi.
  ///
  /// `tugilganYili` TUSHIRILMADI: ishlab turgan bazadagi
  /// yozuvlarda faqat yil bor va uni yo'qotish ma'lumot yo'qotish
  /// bo'lardi. Yangi anketalarda ikkisi ham to'ldiriladi (yil
  /// sanadan olinadi), eskilarida esa yil o'z holida qoladi.
  oilaBoshligiTugilganSana DateTime?
  tugilganYili             Int?
  telefon                  String?

  jamiAzo     Int
  bolalarSoni Int @default(0)

  /// Bolalarning yosh guruhlari.
  ///
  /// «12 ta bola» degan raqamdan chora chiqmaydi: 0-3 yosh bola
  /// onasini uyda ushlab turadi, 3-17 yosh bog'cha va maktab
  /// masalasi, 18 dan katta farzand esa aslida ISHSIZ FUQARO va
  /// bandlik markazining ishi. Uchtasiga uch xil chora kerak.
  bolalar0_3Yosh   Int @default(0)
  bolalar3_17Yosh  Int @default(0)
  bolalar18Yoshdan Int @default(0)

  // ── I. MEHNAT VA BANDLIK ──
  mehnatgaLayoqatli       Int  @default(0)
  /// Mehnatga layoqatsizlar - ish yoshida, lekin ishlay olmaydi.
  ///
  /// Nega alohida ustun kerak bo'ldi: dalada shunday xonadon
  /// chiqdi - ilgari nogironligi bor edi, hozir rasman yo'q,
  /// lekin o'zini mehnatga layoqatsiz deb hisoblaydi va
  /// ishlamaydi. Xodim uni `mehnatgaLayoqatli` dan chiqarib
  /// tashladi va `ishsizlarSoni` ga qo'shdi - anketa esa
  /// "ishlaydigan + ishsiz, mehnatga layoqatlilardan ko'p" deb
  /// rad etdi. Odam bor, lekin uni yozadigan katak yo'q edi.
  ///
  /// Bu son `ishlaydiganlar + ishsizlarSoni <= mehnatgaLayoqatli`
  /// qoidasiga KIRMAYDI: layoqatsiz odam ishsiz emas, chunki u
  /// ish qidirmaydi. Bandlik markazi unga ish taklif qilmaydi -
  /// unga ijtimoiy yordam kerak.
  mehnatgaLayoqatsiz      Int  @default(0)
  ishlaydiganlar          Int  @default(0)
  /// Davlat korxonalarida band
  davlatKorxonada         Int  @default(0)
  /// Xo'jalik yurituvchi subyektlarda band
  xususiySektorda         Int  @default(0)
  ishsizlarSoni           Int  @default(0)
  /// 3 yoshgacha bola tarbiyasidagi, bog'cha bo'lsa ishlashga tayyor ayollar
  bogchaKutayotganAyollar Int  @default(0)
  /// Qancha vaqtdan buyon ishsiz (oyda) - eng uzun muddat
  ishsizlikMuddatiOy      Int?

  ishTuriIstagi      String?
  kasbHunarIstagi    Boolean  @default(false)
  kasbHunarYonalishi String[]
  bandlikTakliflari  String?

  // ── II. TADBIRKORLIK VA KREDIT-SUBSIDIYA ──
  tadbirkorlikIstagi    Boolean  @default(false)
  tadbirkorlikSohasi    String[]
  moliyaEhtiyoji        Boolean  @default(false)
  moliyaTuri            String[]
  /// So'mda. Byudjet rejasiga to'g'ridan-to'g'ri kiradigan raqam.
  talabQilinganMablag   BigInt?
  mablagYonalishi       String[]
  /// «Бошқа» танланганда — қайси йўналиш экани
  mablagYonalishiBoshqa String?

  // ── II-B. CHET ELDA MEHNAT MIGRATSIYASI ──
  //
  // Xatirchi tumani uchun bu ALOHIDA bo'lim bo'lishi shart:
  // ko'p oilaning asosiy daromadi chet eldagi a'zosidan keladi
  // va bu raqamsiz oila ahvolini to'g'ri baholab bo'lmaydi.
  // "Daromadi yo'q" deb belgilangan oila aslida oyiga bir necha
  // million so'm olayotgan bo'lishi mumkin.

  /// Oilada chet elda ishlayotgan a'zo bormi
  chetElMehnati      Boolean  @default(false)
  /// Nechta a'zo chet elda ishlaydi
  chetElIshchilar    Int      @default(0)
  /// Qaysi davlat(lar)da - katalogdan
  chetElDavlatlari   String[]
  /// Katalogda "Boshqa" tanlansa - davlat nomi qo'lda
  chetElBoshqaDavlat String?
  /// Oyiga oilaga yuboriladigan pul (so'mda).
  ///
  /// Aynan YUBORILADIGAN summa so'raladi, chet eldagi maosh
  /// emas: oila byudjetiga kirib keladigan pul shu.
  chetElOylikPul     BigInt?

  /// Пул қайси валютада айтилган: UZS | USD | EUR.
  ///
  /// Оила қайси пулда олса шунда айтади: Россиядан рубль,
  /// Кореядан доллар. Илгари ҳаммаси «сўм» деб ёзиларди ва
  /// ҳисоботда 500 (доллар) билан 5 000 000 (сўм) бир устунга
  /// қўшилиб кетарди.
  chetElValyuta String?

  /// Ҳисобот учун СЎМГА келтирилган қиймат.
  ///
  /// Сақлаш пайтида ҳисобланади ва ўшанда қотиб қолади: акс
  /// ҳолда курс ўзгарган куни ўтган ойги ҳужжатдаги рақам ҳам
  /// ўзгариб кетарди ва иккита ҳужжат бир-бирига тўғри
  /// келмасди.
  chetElOylikPulSom BigInt?

  /// Қайси шаҳарларда — «давлат|шаҳар» кўринишида
  chetElShaharlari   String[]
  /// «Бошқа давлат» танланганда — шаҳар номи
  chetElBoshqaShahar String?

  // ── III. DAROMAD ──
  oylikDaromad         BigInt?
  daromadManbalari     String[]
  daromadImkoniyati    String?
  kambagallikSabablari String[]

  // ── IV. BOLALAR TA'LIMI ──
  maktabgachaYoshdagi        Int      @default(0)
  maktabgachaQamrovda        Int      @default(0)
  maktabgachaQamrovsizSababi String?
  maktabYoshdagi             Int      @default(0)
  maktabQamrovda             Int      @default(0)
  bolalarQiziqishlari        String[]
  togarakQamrovi             Int      @default(0)
  togarakSababi              String?

  // ── V. SOG'LIQ ──
  uzoqDavolanish       Boolean @default(false)
  uzoqDavolanishIzoh   String?
  doriEhtiyoji         String?
  tibbiyXizmatEhtiyoji String?
  oxirgiTibbiyKorik    String?

  // ── VI. UY-JOY VA KOMMUNAL ──
  uyHolati        String?
  ichimlikSuvi    String?
  sugorishSuvi    Boolean @default(false)
  elektr          Boolean @default(true)
  gaz             Boolean @default(false)
  /// 'Табиий газ' yoki 'Пропан (баллон)'. Farqi muhim: markazlashgan
  /// quvur bor joyda muammo boshqa, balon bilan yashaydigan oilada
  /// boshqa - chora-tadbir ham har xil bo'ladi.
  gazTuri         String?
  kanalizatsiya   Boolean @default(false)
  sanitariya      String?
  boshqaMuammolar String?

  // ── VII. IJTIMOIY HIMOYA ──
  nogironlikBor     Boolean @default(false)
  nogironlikIzoh    String?
  /// Nogironligi bor shaxslar: har biri uchun F.I.Sh. va oiladagi
  /// o'rni. JSON massiv sifatida saqlanadi - alohida jadval
  /// yaratish bu hajm uchun ortiqcha, lekin matn maydonida
  /// saqlash ham noto'g'ri: keyin ularni sanab bo'lmaydi.
  nogironShaxslar   Json?
  yolgizKeksa       Boolean @default(false)
  parvarishgaMuhtoj Boolean @default(false)
  parvarishIzoh     String?
  /// Parvarishga muhtoj shaxslar - nogironlik bilan bir xil shakl
  parvarishShaxslar Json?

  /// Ёлғиз яшовчи кексалар — ким экани.
  ///
  /// Ногиронлик ва парвариш каби: «ҳа, бор» деган белгидан
  /// «Инсон» маркази ҳеч кимни топа олмайди. Исм ва оиладаги
  /// ўрни ёзилса, рўйхат тўғридан-тўғри ишга киради.
  yolgizKeksaShaxslar Json?
  boshqaMuhtojlar     String?

  // ── VIII. HUJJATLASHTIRISH ──
  hujjatlarToliq  Boolean @default(true)
  hujjatIzoh      String?
  xizmatTosiqlari String?

  // ── IX. TOMORQA, YER, CHORVA, HUNARMANDCHILIK ──
  tomorqaBor     Boolean @default(false)
  /// ESKI MAYDON - endi to'ldirilmaydi, `ekinMaydoni` ishlatiladi.
  /// Tushirilmadi: ishlab turgan bazada migratsiya talab qiladi va
  /// eski xatlovlardagi qiymat yo'qolardi.
  tomorqaMaydoni Float?
  /// EKIN ekiladigan maydon.
  ///
  /// Ilgari "tomorqa maydoni" so'ralardi, lekin tomorqaning ustida
  /// uy ham turadi - o'sha yerdan foydalanib bo'lmaydi. Rejalashtirish
  /// uchun ekin ekish mumkin bo'lgan qism kerak.
  ekinMaydoni    Float?

  /// Томорқадан ҚАНЧАЛИК фойдаланилаётгани: 'Alo', 'Yaxshi',
  /// 'Qoniqarli', 'Yomon'.
  ///
  /// ── Нега майдон сони етмайди ──
  ///
  /// «10 сотих ер бор» деган рақамдан ҳеч нарса чиқмайди: ўша
  /// 10 сотих экилган ҳам, ташлаб қўйилган ҳам бўлиши мумкин.
  /// Икковига мутлақо БОШҚА чора керак — биринчисига уруғлик ва
  /// сув, иккинчисига эса аввало сабабини аниқлаш.
  ///
  /// ── Нега кейинги хатлов учун муҳим ──
  ///
  /// Бу баҳо хонадон тарихида сақланади. Кейинги йил ўша
  /// хонадонга борилганда «ўтган сафар ёмон эди, ҳозир
  /// қониқарли» деб КЎРСАТИШ мумкин бўлади. Яъни бу — берилган
  /// ёрдам натижа бердими деган саволнинг ўлчови.
  tomorqaFoydalanish String?

  /// Томорқадан ТАШҚАРИ, фойдаланувдаги ер бормиз.
  ///
  /// Оилада кўпинча томорқадан бошқа ер ҳам бўлади: қариндошдан
  /// қолган, маҳалладан ажратилган, вақтинча берилган. У
  /// ижарага олинган ер эмас (у алоҳида сўралади) ва томорқа
  /// ҳам эмас — лекин режалаштиришда ҳисобга олиниши керак,
  /// чунки унда ҳам экин экса бўлади.
  qoshimchaYerBor     Boolean @default(false)
  qoshimchaYerMaydoni Float?

  /// Chorvachilik alohida savol bo'ldi: ilgari erkin matn edi va
  /// "bor", "yo'q", "2 ta sigir" kabi turli javoblar tushardi -
  /// ularni sanab bo'lmasdi.
  chorvaBor     Boolean  @default(false)
  /// 'Йирик шохли', 'Майда шохли', 'Парранда' - bir nechtasi
  chorvaTurlari String[]

  /// Чорва БОШ сони — тур бўйича.
  ///
  /// «Чорваси бор» деган белгидан режа чиқмайди: 2 та товуқ ҳам,
  /// 40 та қорамол ҳам бир хил кўринади. Субсидия ва ем-хашак
  /// ёрдами эса айнан бош сонига қараб берилади.
  yirikShoxliSoni Int?
  maydaShoxliSoni Int?
  parrandaSoni    Int?
  chorvachilik    String?

  hunarmandBor     Boolean  @default(false)
  /// Tayyor variantlar ro'yxatidan tanlanadi
  hunarTurlari     String[]
  /// Faqat "Бошқа" belgilanganda to'ldiriladi
  hunarmandchilik  String?
  zarurKomak       String[]
  issiqxonaTalabi  Boolean  @default(false)
  issiqxonaMaydoni Float?
  ijaraYer         Boolean  @default(false)
  ijaraYerMaydoni  Float?

  // ── X. PASSIV DAROMAD ──

  /// Оила пассив даромадга тайёрми.
  ///
  /// Иш ўрни ва тадбиркорликдан ФАРҚЛИ учинчи йўл. Ёши катта,
  /// соғлиғи заиф ёки бола парвариши билан банд аъзони ишга
  /// жойлаштириб бўлмайди — лекин мулкини ишлатиш мумкин.
  passivDaromadIstagi  Boolean  @default(false)
  passivDaromadTurlari String[]

  /// Ҳар бир восита учун МИҚДОР: `{ "Tovuq": 100, "Sigir": 1 }`.
  ///
  /// Миқдор каталогда эмас, шу ерда — чунки уни ФУҚАРО айтади.
  /// Илгари каталогда «100 та товуқ» деб турарди, яъни туман
  /// миқдорни олдиндан белгилаб қўйган бўларди. Амалда эса
  /// битта оилага 20 та товуқ етади, бошқасида катта ҳовли бор
  /// ва 300 тасини боқа олади.
  ///
  /// Нега `Json` ва алоҳида устун эмас: воситалар рўйхати
  /// ўзгаради (ҳоким кейинги йил янгисини қўшади), ҳар бири
  /// учун устун очиш эса миграция талаб қиларди.
  passivDaromadSonlari Json?
  /// «Бошқа» танланганда ёки қўшимча изоҳ
  passivDaromadIzohi   String?

  // ── XI. MAHALLA INFRATUZILMASI ──

  /// Маҳалладаги инфратузилма муаммолари.
  ///
  /// Анкетанинг қолган ҳамма бўлими ХОНАДОН ҳақида. Аммо оилани
  /// камбағалликдан чиқаришга тўсқинлик қиладиган нарса кўпинча
  /// хонадонда эмас, КЎЧАДА туради: йўл йўқ — маҳсулот бозорга
  /// чиқмайди; боғча йўқ — аёл ишга чиқолмайди; интернет йўқ —
  /// масофадан ишлаш мумкин эмас.
  ///
  /// 40 000 хонадондан йиғилганда бу туман учун тайёр
  /// инвестиция режаси бўлади.
  infratuzilmaMuammolari String[]
  /// «Бошқа» танланганда — қайси муаммо
  infratuzilmaBoshqa     String?
  /// Фуқаронинг ўз сўзи билан изоҳ
  infratuzilmaIzohi      String?

  // ── ESKI: XII-BO'LIM «XULOSA» ──
  //
  // Anketadan OLIB TASHLANGAN (2026-yil 16-sentabr, hokimiyat
  // talabi bilan). Mahalla xodimi bu katakni to'ldirmaydi va
  // xonadon sahifasida ham ko'rsatilmaydi.
  //
  // Ustunning o'zi bazada QOLDIRILDI: unda ilgari kiritilgan
  // yozuvlar bo'lishi mumkin va ularni o'chirish ma'lumot
  // yo'qotish demakdir. Yangi yozuvlarda u doim bo'sh bo'ladi.
  umumiyXulosa String?

  /// Tayyorlangan tavsiya - JSON matn sifatida:
  /// `{ manba, holat, tavsiyalar: [{ daraja, sarlavha, dalil }] }`.
  ///
  /// Alohida ustun ochilmadi: bu ma'lumot bo'yicha qidirilmaydi
  /// va sanalmaydi, u faqat o'qiladi. Shakli o'zgarsa, eski
  /// yozuv xom matn sifatida ko'rsatiladi - yo'qolmaydi.
  ///
  /// Xonadon ma'lumoti AI ga ISMSIZ yuboriladi: F.I.Sh., manzil,
  /// telefon va xodim yozgan HAR QANDAY erkin matn chiqarib
  /// tashlanadi, faqat sonlar va katalog qiymatlari qoladi.
  /// Shuning uchun bu matnda ham shaxs nomi bo'lmaydi.
  aiXulosa      String?
  aiXulosaVaqti DateTime?
  /// Qaysi usul ishlatilgani: 'ai' yoki 'qoida'
  aiManbasi     String?

  // ── ROZILIK VA IMZO ──
  /// Fuqaro ma'lumot yig'ilishiga rozi bo'lgani. Busiz yakuniy
  /// yuborish tugmasi ochilmaydi.
  rozilikBerdi Boolean   @default(false)
  /// Ekranda chizilgan imzo - SVG yo'l ma'lumoti sifatida.
  /// Rasm emas: yo'l bir necha kilobayt, PNG esa o'nlab. 40 ming
  /// xonadonda bu farq gigabaytlarga chiqadi.
  imzoYoli     String?
  imzoVaqti    DateTime?

  // ── Xizmat maydonlari ──
  xatlovSanasi DateTime @default(now())
  xodimId      String
  xodim        User     @relation(fields: [xodimId], references: [id], onDelete: Restrict)

  /// Takror xatlovni aniqlash uchun kalit: mahalla + manzil + oila
  /// boshlig'i, apostrof va bo'shliqlarsiz normallashtirilgan.

  // ── ARXIV ──
  //
  // Xatlov O'CHIRILMAYDI, arxivga olinadi.
  //
  // Sabab: `ActionPlan` va `HouseholdKesma` da `onDelete: Cascade`
  // turibdi. Haqiqiy o'chirish xonadon bilan birga uning
  // topshiriqlarini va butun tarixini ham jimgina yo'q qilardi —
  // va uni hech narsa qaytara olmasdi. 72 ta xodim ishlaydigan
  // tizimda bitta noto'g'ri bosish shunday oqibatga olib kelishi
  // mumkin emas.
  //
  // Arxivdagi yozuv hech qayerda ko'rinmaydi: ro'yxatda ham,
  // hisobotda ham, hokimning raqamlarida ham. Lekin administrator
  // uni qaytara oladi.
  /// Arxivga olingan sana. `null` — faol yozuv.
  arxivSanasi DateTime?
  arxivchiId  String?
  arxivSababi String?

  takrorKaliti String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ishsizlar    UnemployedPerson[]
  topshiriqlar ActionPlan[]
  /// Vaqt kesimidagi holatlar - "yil boshida qanday edi"
  kesmalar     HouseholdKesma[]

  /// Bir xonadonni ikki marta kiritish mumkin emas
  @@unique([mahallaId, takrorKaliti])
  @@index([arxivSanasi])
  @@index([mahallaId, holati])
  @@index([xodimId])
  @@index([xatlovSanasi])
}

// ─────────────────────────────────────────────────────────────
//  ISHSIZ FUQARO - SHAXSIY ANKETA VA HAYOT SIKLI
// ─────────────────────────────────────────────────────────────

/// Ishsiz fuqaroning bandlik yo'lidagi holati.
///
/// Bu platformaning YURAGI. Hokim "nechta ishsiz bor" degan raqamni
/// allaqachon biladi (3 345). Unga kerak bo'lgani - shu 3 345 tadan
/// nechtasi qaysi bosqichda turgani.
enum IshsizHolati {
  /// Xonadon xatlovida aniqlangan, lekin hali suhbat bo'lmagan
  ANIQLANDI
  /// Bandlik mutaxassisi suhbat o'tkazdi va anketani to'ldirdi
  SUHBAT_OTKAZILDI
  /// Aniq taklif berildi (ish o'rni, YaTT, kredit, kurs...)
  TAKLIF_BERILDI
  /// Ishga joylashtirildi yoki o'z ishini boshladi
  JOYLASHTIRILDI
  /// Joylashtirilgani 3 oydan keyin tekshirildi va tasdiqlandi
  TASDIQLANDI
  /// Fuqaro taklifdan bosh tortdi - sababi yoziladi
  RAD_ETDI
}

model UnemployedPerson {
  id     String       @id @default(cuid())
  holati IshsizHolati @default(ANIQLANDI)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  // ── 3-4. Shaxsiy ma'lumot ──
  fish             String
  telefon          String?
  jinsi            String
  oilaviyHolat     String?
  farzandlarSoni   Int?
  millati          String?
  tugilganSana     DateTime?
  malumoti         String?
  mutaxassisligi   String?
  sogliqHolati     String?
  nogironlik       Boolean   @default(false)
  nogironlikGuruhi String?
  yashashManzili   String?

  // ── 4.10-4.18 ──
  kasbHunarEhtiyoji       Boolean   @default(false)
  organmoqchiKasb         String?
  ishTajribasiYil         Float?
  avvalgiIshJoyi          String?
  oxirgiIshJoyi           String?
  ishdanBoshaganSana      DateTime?
  xohlaganIsh             String?
  kutilayotganMaosh       BigInt?
  ishgaTayyorligi         String?
  haydovchilikGuvohnomasi Boolean   @default(false)
  haydovchilikToifasi     String[]

  /// IT-shaharchaga VAUCHER bilan yo'naltirilganmi.
  ///
  /// `takliflar` ro'yxatida ham "IT-shaharchaga yo'naltirish"
  /// bandi bor, lekin u SUHBAT natijasi - bandlik mutaxassisi
  /// to'ldiradi. Bu maydon esa XATLOV paytida, mahalla xodimi
  /// eshik oldida belgilaydi: fuqaro IT o'rganmoqchi ekan va
  /// IT-shaharchaga yo'naltirilsin.
  ///
  /// Bu ISTAK, vaucherning o'zi emas. Haqiqiy vaucher `ItVaucher`
  /// jadvalida - raqami, yo'nalishi va holati bilan. Ikkovi
  /// ataylab ajratilgan: bu yerda `true` turgan-u `ItVaucher`
  /// yozuvi yo'q odam - aynan ZANJIR UZILGAN joyi. Bandlik
  /// paneli shu ro'yxatni ko'rsatadi.
  itShaharchaVaucheri Boolean @default(false)

  /// Berilgan IT-shaharcha vaucherlari. Odatda bitta, lekin
  /// birinchisi bekor bo'lib ikkinchisi berilishi mumkin -
  /// shuning uchun ro'yxat.
  itVaucherlar    ItVaucher[]
  imtiyozEhtiyoji Boolean     @default(false)
  imtiyozTuri     String[]

  // ── 5. Bandlikni ta'minlash bo'yicha takliflar ──
  takliflar   String[]
  taklifIzohi String?
  /// XULOSA bo'limi
  xulosa      String?

  // ── Natija ──
  /// Qayerga joylashtirildi - e'londagi korxona nomi ko'chiriladi
  ishJoyi         String?
  ishLavozimi     String?
  ishgaKirganSana DateTime?
  /// Rad etgan bo'lsa - sababi
  radSababi       String?

  /// Qaysi E'LONGA joylashtirildi.
  ///
  /// `ishJoyi` erkin matn bo'lib qolaveradi: fuqaro e'lonsiz,
  /// o'zi topgan ishga ham joylashishi mumkin. Lekin e'lon orqali
  /// joylashtirilganda bu maydon to'ldiriladi va shundan keyingina
  /// "qaysi o'rin band bo'ldi", "e'londan nechta odam ishga
  /// kirdi" degan savollarga javob bor.
  vacancyId String?
  vacancy   Vacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  /// Маҳалла ходими юборган «иш топдим» хабарлари
  joylashuvXabarlari JoylashuvXabari[]

  // ── Suhbat o'tkazgan mutaxassis ──
  suhbatSanasi DateTime?
  mutaxassisId String?
  mutaxassis   User?     @relation(fields: [mutaxassisId], references: [id], onDelete: SetNull)

  /// Xonadonda birgalikda tushilgan rasm (anketa talabi)
  rasmUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── ARXIV ──
  //
  // Fuqaro ham o'chirilmaydi, arxivga olinadi: unga berilgan
  // topshiriqlar, IT-vaucher va joylashtirish tarixi yo'qolmasin.
  /// Arxivga olingan sana. `null` — faol yozuv.
  arxivSanasi DateTime?
  arxivchiId  String?
  arxivSababi String?

  topshiriqlar ActionPlan[]

  @@index([mahallaId, holati])
  @@index([holati])
  @@index([householdId])
  @@index([arxivSanasi])
  @@index([mutaxassisId])
  @@index([vacancyId])
}

// ─────────────────────────────────────────────────────────────
//  CHORA-TADBIRLAR REJASI
// ─────────────────────────────────────────────────────────────

enum TopshiriqHolati {
  KUTILMOQDA
  BAJARILMOQDA
  BAJARILDI
  /// Muddati o'tgan va bajarilmagan. Har kecha avtomatik belgilanadi.
  KECHIKDI
  BEKOR_QILINDI
}

/// Anketaning X/XI bo'limi: muammo -> sabab -> yechim -> mas'ul -> muddat.
///
/// Bu jadval platformani so'rovnomadan ISH YURITISH TIZIMIGA
/// aylantiradi. Hokim paneli "kechikkan topshiriqlar mas'ul tashkilot
/// kesimida" degan ko'rinishni aynan shundan oladi - va bu eng
/// kuchli hisobdorlik quroli.
model ActionPlan {
  id     String          @id @default(cuid())
  holati TopshiriqHolati @default(KUTILMOQDA)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  ishsizId String?
  ishsiz   UnemployedPerson? @relation(fields: [ishsizId], references: [id], onDelete: Cascade)

  muammo         String
  sababi         String?
  yechim         String
  masulTashkilot String
  muddat         DateTime

  bajarilganSana DateTime?
  natijaIzohi    String?

  yaratganId String
  yaratgan   User   @relation(fields: [yaratganId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([masulTashkilot, holati])
  @@index([muddat, holati])
  @@index([householdId])
  @@index([ishsizId])
}

// ─────────────────────────────────────────────────────────────
//  XABARNOMA - TELEGRAM
// ─────────────────────────────────────────────────────────────

/// Xabar nima haqida
enum XabarTuri {
  /// Mahallaga mos bo'sh ish o'rni e'loni chiqdi
  YANGI_ISH_ORNI
  /// IT-shaharcha vaucherini kutayotgan fuqaro bor
  VAUCHER_KUTMOQDA
  /// Chora-tadbir muddati yaqinlashdi yoki o'tdi
  TOPSHIRIQ_MUDDATI

  /// Mahalla xodimi «shu fuqaroga ish topdim» deb xabar qildi.
  /// Bandlik markaziga - tasdiqlash uchun.
  ISH_TOPILDI

  /// Bandlik markazi xabarni tasdiqladi, fuqaro rasman ishga
  /// joylashdi. Hokimga va xabar qilgan xodimga boradi.
  JOYLASHUV_TASDIQLANDI
  /// Bog'lashni tasdiqlash
  ULANISH
}

/// Xabarning yo'li
enum XabarHolati {
  /// Navbatda, hali yuborilmagan
  KUTILMOQDA
  /// Telegram qabul qildi
  YUBORILDI
  /// Yuborib bo'lmadi - sababi `xatoMatni` da
  XATO
  /// Bekor qilindi (xodim bog'lanishni uzdi, e'lon yopildi...)
  BEKOR
}

/// Telegram orqali yuboriladigan xabar - NAVBAT va JURNAL.
///
/// ── Nega jadval kerak, to'g'ridan-to'g'ri yuborilmaydi ──
///
/// Telegram ishlamay turishi mumkin: server javob bermaydi,
/// internet uziladi, bot bloklanadi. Agar xabar to'g'ridan-
/// to'g'ri yuborilsa, u shunchaki YO'QOLADI va hech kim
/// bilmaydi - xodim esa "menga xabar kelmadi" deb aytmaydi,
/// chunki u xabar kutilganini ham bilmaydi.
///
/// Navbat jadvali buni ko'rsatadi: administrator panelida
/// "12 ta xabar yuborilmadi" deb turadi va sababi ham yozilgan.
///
/// ── Nega matn saqlanadi ──
///
/// Xabar yuborilgandan keyin ham matni qoladi: "xodimga nima
/// deb yozgan edik" degan savolga javob kerak bo'ladi.
model Xabarnoma {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  turi   XabarTuri
  holati XabarHolati @default(KUTILMOQDA)

  /// Yuboriladigan matn - Telegram HTML formatida
  matn String

  /// Nechta marta urinildi. Uch martadan keyin to'xtaydi:
  /// bot bloklangan bo'lsa, cheksiz urinish foydasiz.
  urinishlar Int @default(0)

  /// Nega yuborilmagani - administrator shuni o'qiydi
  xatoMatni String?

  yuborilganSana DateTime?

  /// Nima haqida - yozuvga qaytish uchun
  bogliqTuri String?
  bogliqId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([holati, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
//  XONADON TARIXI - KESMALAR
// ─────────────────────────────────────────────────────────────

/// Kesma nima sababdan olingani
enum KesmaSababi {
  /// Birinchi marta xatlovdan o'tdi
  ILK_XATLOV
  /// Qayta xatlov yoki tahrir - yuborilgan holatga qaytdi
  QAYTA_XATLOV
  /// Eski yozuvlar uchun bir martalik to'ldirish
  BOSHLANGICH
}

/// Xonadonning MA'LUM PAYTDAGI holati.
///
/// ── Nega kerak ──
///
/// `Household` jadvalida faqat OXIRGI holat turadi. Xatlov qayta
/// o'tkazilsa, eski raqamlar ustidan yozilib ketadi va "bu oila
/// yil boshida qanday edi" degan savolga javob qolmaydi.
///
/// Kambag'allikdan chiqishni o'lchash esa aynan shu savolga
/// tayanadi. Raqam o'sgani yetmaydi: xatlov davom etayotgani
/// uchun umumiy raqam baribir o'sadi. Kerakli savol boshqa -
/// "O'SHA OILA ilgarigidan yaxshiroq yashayaptimi".
///
/// ── Nega hamma ustun ko'chirilmaydi ──
///
/// `Household` da 160 dan ortiq maydon bor. Ularning ko'pi
/// o'zgarmaydi (manzil, oila boshlig'i ismi) yoki taqqoslashga
/// yaramaydi (izohlar, imzo). Shuning uchun bu yerda faqat
/// HARAKATDAGI ko'rsatkichlar alohida ustun bo'lib turadi -
/// ular bo'yicha SQL so'rov yozish mumkin.
///
/// To'liq yozuv esa `toliq` ichida JSON bo'lib saqlanadi: keyin
/// boshqa savol tug'ilsa, ma'lumot yo'qolmagan bo'ladi.
model HouseholdKesma {
  id String @id @default(cuid())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  /// Maхsus takrorlanadi: 70 ta mahalla xodimining izolyatsiyasi
  /// so'rovning o'zida, qo'shimcha JOIN'siz ta'minlanadi
  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  olinganSana DateTime    @default(now())
  sababi      KesmaSababi @default(QAYTA_XATLOV)

  // ── Oila tarkibi ──
  jamiAzo     Int
  bolalarSoni Int @default(0)

  // ── Mehnat va bandlik ──
  mehnatgaLayoqatli  Int @default(0)
  mehnatgaLayoqatsiz Int @default(0)
  ishlaydiganlar     Int @default(0)
  ishsizlarSoni      Int @default(0)

  // ── Daromad ──
  oylikDaromad      BigInt?
  /// `oylikDaromad / jamiAzo` - kambag'allikning asosiy o'lchovi.
  /// Alohida saqlanadi, chunki oila a'zolari soni ham o'zgaradi
  /// va keyinchalik qayta hisoblab bo'lmaydi.
  jonBoshigaDaromad BigInt?
  chetElOylikPulSom BigInt?

  // ── Xo'jalik ──
  yirikShoxliSoni Int?
  maydaShoxliSoni Int?
  parrandaSoni    Int?
  tomorqaMaydoni  Float?
  ekinMaydoni     Float?

  /// Томорқадан фойдаланиш даражаси — ўша кундаги баҳо.
  ///
  /// Кесмада сақланишининг сабаби шу: кейинги йил ўша хонадонга
  /// борилганда «ўтган сафар ёмон эди» деб КЎРСАТИШ мумкин
  /// бўлсин. Берилган ёрдам натижа бердими — шундан билинади.
  tomorqaFoydalanish String?

  qoshimchaYerMaydoni Float?

  // ── Yashash sharoiti ──
  gaz          Boolean @default(false)
  ichimlikSuvi String?
  uyHolati     String?

  // ── Istaklar ──
  tadbirkorlikIstagi Boolean @default(false)
  kasbHunarIstagi    Boolean @default(false)

  /// Nogironligi bo'lgan shaxslar soni
  nogironSoni Int @default(0)

  /// Anketa javoblaridan hisoblangan 0-100 oralig'idagi ko'rsatkich.
  ///
  /// DIQQAT: bu RASMIY kambag'allik mezoni EMAS va oilalarni
  /// bir-biri bilan taqqoslash uchun ham emas. U faqat BITTA
  /// oilani O'ZI bilan vaqt kesimida taqqoslash uchun xizmat
  /// qiladi: "shu xonadonda ahvol yaxshilandimi".
  ///
  /// Hisoblash usuli `src/lib/xonadon-tarixi.ts` da ochiq yozilgan
  /// va hisobotda ham ko'rsatiladi - yopiq formula bo'lmasligi
  /// kerak, aks holda unga ishonib bo'lmaydi.
  farovonlikBali Int

  /// O'sha paytdagi TO'LIQ yozuv - kelajakdagi savollar uchun
  toliq Json

  createdAt DateTime @default(now())

  @@index([householdId, olinganSana])
  @@index([mahallaId, olinganSana])
}

// ─────────────────────────────────────────────────────────────
//  IT-SHAHARCHA VAUCHERI
// ─────────────────────────────────────────────────────────────

/// Vaucherning yo'li: berildi -> o'qimoqda -> tugatdi -> ishga
/// joylashdi. Ikki chiqish yo'li ham bor va ular YASHIRILMAYDI:
/// hokim uchun eng muhim raqam "vaucher berildi, natija yo'q".
enum ItVaucherHolati {
  /// Vaucher yozildi, fuqaro hali kursni boshlamagan
  BERILDI
  /// Kursda o'qiyapti
  OQIMOQDA
  /// Kursni tugatdi, sertifikat oldi
  TUGATDI
  /// Kasb bo'yicha ishga joylashdi yoki o'z ishini boshladi
  ISHGA_JOYLASHDI
  /// Boshladi, lekin tashlab ketdi - sababi izohda
  TASHLAB_KETDI
  /// Bekor qilindi (fuqaro voz kechdi, guruh ochilmadi...)
  BEKOR_QILINDI
}

/// IT-shaharchada TEKINGA kasb o'rganish uchun beriladigan
/// vaucher.
///
/// Nega alohida jadval, `UnemployedPerson` dagi bitta belgi
/// yetmaydi:
///
///   - Belgi faqat "ha" deydi. Hokimning savoli esa boshqa:
///     "nechta vaucher berdik, nechtasi kursni tugatdi,
///     nechtasi ishga joylashdi va nechtasi bekorga ketdi".
///   - Yo'nalish kerak: sun'iy intellektga talab ko'pmi yoki
///     dizaynga - keyingi guruh shunga qarab ochiladi.
///   - Sana kerak: vaucher berilgandan keyin odam olti oy
///     qimirlamasa, bu KO'RINISHI kerak.
///
/// `mahallaId` ataylab takrorlanadi (fuqaroda ham bor): 70 ta
/// mahalla xodimi faqat o'zinikini ko'rishi shart, va bu
/// cheklov bitta ustunda, so'rovning o'zida turgani xavfsizroq
/// bo'ladi - qo'shimcha JOIN unutilib qolmaydi.
model ItVaucher {
  id     String          @id @default(cuid())
  /// Qog'ozdagi vaucher raqami: IT-2026-0001
  raqami String          @unique
  holati ItVaucherHolati @default(BERILDI)

  ishsizId String
  ishsiz   UnemployedPerson @relation(fields: [ishsizId], references: [id], onDelete: Cascade)

  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  /// `IT_YONALISHI` katalogidan. Fuqaroning o'z so'zi
  /// `organmoqchiKasb` da qoladi - bu esa shu istak qaysi
  /// guruhga tushishi.
  yonalish       String
  /// "Boshqa" tanlanganda yoziladi
  boshqaYonalish String?

  berilganSana    DateTime  @default(now())
  boshlanganSana  DateTime?
  tugatganSana    DateTime?
  ishgaKirganSana DateTime?

  /// Nima bo'lgani - ayniqsa tashlab ketgan va bekor qilinganda
  izoh String?

  bergangaId String
  bergan     User   @relation(fields: [bergangaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mahallaId, holati])
  @@index([holati, berilganSana])
  @@index([ishsizId])
}

// ─────────────────────────────────────────────────────────────
//  BO'SH ISH O'RINLARI
// ─────────────────────────────────────────────────────────────

/// Xatlovning X bo'limida mahalladagi tadbirkorlik subyektlari va
/// ulardagi bo'sh ish o'rinlari qayd etiladi. Bu jadval ularni
/// nomma-nom saqlaydi - moslashtirish taxtasi shunga tayanadi.
/// Bo'sh ish o'rni e'loni nega yopilgani
enum VacancyYopilishi {
  /// Barcha o'rinlar band bo'ldi - avtomatik yopildi
  TOLDI
  /// Xodim qo'li bilan yopdi (korxona voz kechdi, fikridan qaytdi...)
  QOLDA
  /// Amal qilish muddati tugadi - avtomatik yopildi
  MUDDATI_TUGADI
}

model Vacancy {
  id        String  @id @default(cuid())
  mahallaId String
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Restrict)

  korxonaNomi String
  lavozim     String
  /// Kasb yo'nalishi - nomzod istagi bilan solishtirish uchun
  yonalish    String?
  ornlarSoni  Int     @default(1)
  maosh       BigInt?
  talablar    String?
  telefon     String?

  /// E'lon qachongacha kuchda. Muddat o'tgach e'lon o'z-o'zidan
  /// yopiladi.
  ///
  /// ── Nega kerak bo'ldi ──
  ///
  /// Ilgari e'lon QO'LDA yopilmaguncha abadiy faol turardi.
  /// Korxona fikridan qaytsa yoki o'rinni boshqa yo'l bilan
  /// to'ldirsa, hech kim kelib e'lonni yopmasdi - va mahalla
  /// xodimlari allaqachon o'lgan e'lon bo'yicha odam yuborib
  /// yuraverardi. Fuqaro borib "bunday ish yo'q" deb qaytardi.
  ///
  /// Endi har e'lonning oxiri bor. Bo'sh qoldirilsa - muddatsiz,
  /// lekin shakl o'zi bir oy qo'yib beradi.
  amalQilishMuddati DateTime?

  faol           Boolean           @default(true)
  /// Nega yopilgani. `faol = false` bo'lganda to'ldiriladi.
  ///
  /// Buni saqlash shart: o'rin to'lgani uchun avtomatik yopilgan
  /// e'lon joylashtirish bekor qilinsa QAYTA ochilishi kerak,
  /// xodim qo'li bilan yopgani esa ochilmasligi kerak. Sababsiz
  /// ikkalasi bir xil ko'rinardi.
  yopilishSababi VacancyYopilishi?
  yopilganSana   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Shu e'lon orqali ishga joylashtirilgan fuqarolar
  joylashganlar      UnemployedPerson[]
  joylashuvXabarlari JoylashuvXabari[]

  @@index([mahallaId, faol])
  @@index([yonalish, faol])
  @@index([faol, amalQilishMuddati])
}

// ─────────────────────────────────────────────────────────────
//  AUDIT JURNALI
// ─────────────────────────────────────────────────────────────

/// Kim qachon nimani ko'rgani va eksport qilgani.
///
/// Xatlov ma'lumotlari oila daromadi va sog'liq holatini o'z ichiga
/// oladi. Kim ularni ko'rgani yozib borilmasa, ma'lumot tarqalganda
/// javobgarni aniqlab bo'lmaydi.
model AuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// KIRISH, KORISH, YARATISH, OZGARTIRISH, EKSPORT, OCHIRISH
  amal       String
  obyektTuri String?
  obyektId   String?
  izoh       String?
  ip         String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([amal, createdAt])
}

/// Joylashuv xabarining holati
enum JoylashuvHolati {
  /// Mahalla xodimi xabar qildi, markaz hali ko'rmadi
  XABAR_QILINDI
  /// Markaz tasdiqladi - fuqaro rasman joylashtirildi
  TASDIQLANDI
  /// Markaz rad etdi - sababi yoziladi
  RAD_ETILDI
}

/// ============================================================
///  «ИШ ТОПДИМ» ХАБАРИ
///
///  Занжирнинг етишмаган ҳалқаси. Илгари шундай эди:
///
///    эълон → маҳалла ходимига хабар → ... → ҲЕЧ НАРСА
///
///  Ходим одамни ишга жойлаштирса ҳам, бу тизимга тушмасди:
///  унда жойлаштириш ҳуқуқи йўқ, Telegram эса бир томонлама
///  эди. Натижа маҳалла даражасида қолиб кетарди.
///
///  ── Нега алоҳида модел, тўғридан-тўғри жойлаштириш эмас ──
///
///  Расмий жойлаштириш — бандлик марказининг иши: ҳужжат,
///  шартнома, ҳисобот ўшанда. 70 та маҳалла ходими туман
///  рақамини бевосита ўзгартира олса, рақам ҳужжатсиз ўсиб
///  кетарди.
///
///  Шунинг учун ходимнинг тугмаси ХАБАР ёзади. Марказ уни
///  тасдиқлагач, мавжуд жойлаштириш мантиғи ишлайди ва
///  фуқаро расман ЖОЙЛАШТИРИЛДИ бўлади.
///
///  Ҳар ҳалқанинг ўз фойдаси бор: ходим дала билимини
///  киритади, марказ рақамни тасдиқлайди, ҳоким эса кутмасдан
///  кўради.
/// ============================================================
model JoylashuvXabari {
  id     String          @id @default(cuid())
  holati JoylashuvHolati @default(XABAR_QILINDI)

  vacancyId String
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  ishsizId String
  ishsiz   UnemployedPerson @relation(fields: [ishsizId], references: [id], onDelete: Cascade)

  /// Xabar qilgan mahalla xodimi
  xabarchiId String
  xabarchi   User   @relation("JoylashuvXabarchi", fields: [xabarchiId], references: [id], onDelete: Restrict)

  /// Markaz shu sanagacha tasdiqlashi kerak.
  /// O'tib ketsa - kechikkanlar ro'yxatiga tushadi va
  /// hokimning panelida ko'rinadi.
  muddat DateTime

  /// Tasdiqlagan yoki rad etgan mutaxassis
  halQilganId String?
  halQilgan   User?   @relation("JoylashuvHalQilgan", fields: [halQilganId], references: [id], onDelete: SetNull)

  halQilinganSana DateTime?
  /// Rad etilsa - sababi. Tasdiqlansa - qo'shimcha izoh.
  izoh            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bitta fuqaro bitta e'longa BIR MARTA xabar qilinadi.
  /// Tugma ikki marta bosilsa, ikkinchisi shu yerda to'xtaydi.
  @@unique([vacancyId, ishsizId])
  @@index([holati, muddat])
  @@index([xabarchiId, holati])
}
